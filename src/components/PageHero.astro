---
/**
 * Hero compacto para páginas internas (Soporte, Preguntas frecuentes…).
 * Mismo lenguaje navy del Home. Deja espacio abajo (pb) para que el
 * contenido siguiente se sobreponga con `-mt-12`.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import { brandHtml } from "../utils/brand";

interface Props {
  id: string;
  /** Nombre de la página en las migas de pan. */
  crumb: string;
  /** Título dividido para resaltar una palabra en naranja. */
  titleBefore: string;
  titleHighlight: string;
  titleAfter?: string;
  /** Opcional: si no se pasa, el encabezado va solo con el título. */
  subtitle?: string;
  /** Mimo u otra ilustración (solo se muestra en escritorio). */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { id, crumb, titleBefore, titleHighlight, titleAfter = "", subtitle, image, imageAlt = "" } = Astro.props;
---

<!-- Mismo contenedor que el Header y el banner del Home: los bordes coinciden con el logo y el botón "Cámbiate". -->
<section aria-labelledby={id} class="container mx-auto px-4 pt-3 sm:px-6">
  <div class="relative overflow-hidden rounded-hero bg-gradient-to-br from-mega-navy via-[#0A1E3D] to-[#0D2854] text-white">
    <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-mega-orange/20 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 flex items-center justify-between gap-6 px-5 pb-20 pt-8 sm:px-10 sm:pt-10 md:pb-24 lg:px-14">
      <div>
        <nav aria-label="Ruta de navegación" class="mb-3">
          <ol class="flex items-center gap-1.5 text-xs font-bold text-slate-400">
            <li><a href="/" class="hover:text-white">Inicio</a></li>
            <li aria-hidden="true"><Icon name="arrow-right" class="h-3 w-3" /></li>
            <li aria-current="page" class="text-white">{crumb}</li>
          </ol>
        </nav>
        <h1 id={id} class="font-display text-3xl sm:text-4xl lg:text-5xl font-black uppercase leading-[1.05] tracking-tight">
          <Fragment set:html={brandHtml(titleBefore)} /><span class="text-mega-orange" set:html={brandHtml(titleHighlight)} /><Fragment set:html={brandHtml(titleAfter)} />
        </h1>
        {subtitle && <p class="mt-2 max-w-xl text-sm sm:text-base font-semibold text-slate-300">{subtitle}</p>}
        {/* Botones opcionales (páginas de producto como eSIM). Las páginas de ayuda no los usan. */}
        {Astro.slots.has("actions") && (
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <slot name="actions" />
          </div>
        )}
      </div>

      {image && <Image src={image} alt={imageAlt} width={240} format="webp" class="hidden md:block h-auto w-40 lg:w-48 shrink-0" />}
    </div>
  </div>
</section>
