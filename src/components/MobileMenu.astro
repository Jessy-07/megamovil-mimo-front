---
/**
 * Menú de celular/tablet (< lg), a PANTALLA COMPLETA (un <dialog>; lo abre el botón ☰ del header con [data-menu-open]).
 * Zonas, de arriba a abajo:
 * 1. Logo + cerrar.
 * 2. Sucursal en una línea ("Promos en X · Cambiar") → abre el buscador de sucursal (BranchPicker).
 * 3. Lo que vende, en filas grandes (56 px): Planes, Portabilidad, Promociones, eSIM.
 * 4. "Consulta" como cuadrícula de iconos (se reconoce de un vistazo y ocupa menos alto que una lista).
 * 5. "Ayuda" en acordeón (secundaria).
 * 6. Fijo abajo: "Cámbiate a Mega móvil" (abre el popup "¡Llámame!") + teléfono y WhatsApp.
 * Enlaces en nav.json → menu.
 */
import nav from "../data/nav.json";
import site from "../data/site.json";
import sucursales from "../data/sucursales.json";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { whatsappUrl } from "../utils/whatsapp";
import { resolveAnchor } from "../utils/links";

const path = Astro.url.pathname;
const getHref = (href: string) => resolveAnchor(href, path);
const currentPath = path.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => href.startsWith("/") && href.replace(/\/$/, "") === currentPath;
const isExternal = (l: { href: string; target?: string }) => l.target === "_blank" || l.href.startsWith("http");

const consulta = nav.menu.find((m) => m.label === "Consulta")?.children ?? [];
const ayuda = nav.menu.find((m) => m.label === "Ayuda")?.children ?? [];
const planes = consulta.find((c) => c.href === "/planes");
const direct = nav.menu.filter((m) => !("children" in m) && "href" in m) as { label: string; href: string }[];
const primary = [...(planes ? [planes] : []), ...direct];
const tiles = consulta.filter((c) => c !== planes);

// Íconos de la cuadrícula "Consulta" (trazo, estilo Lucide), por destino.
const tileIcons: Record<string, string> = {
  "/roaming-internacional": '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  "#recargas": '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  "/compatibilidad": '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/>',
  "/beneficios": '<path d="M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>',
  "/cobertura": '<path d="M2 20h.01M7 20v-4M12 20v-8M17 20V8M22 4v16"/>',
};
const idIcon = '<rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="8" cy="12" r="2"/><path d="M13 10h5M13 14h3"/>';
const tileIcon = (href: string) => tileIcons[href] ?? idIcon;

// Etiquetas cortas para la cuadrícula (caben en 2 líneas en 3 columnas).
const shortLabel: Record<string, string> = { "Planes Internacionales": "Roaming internacional" };

const phone = nav.topBar.phone;
---

<dialog
  id="mobile-menu"
  aria-label={nav.menuLabel}
  class="m-0 h-[100dvh] max-h-none w-full max-w-none bg-white p-0 text-mega-navy backdrop:bg-transparent lg:hidden"
>
  <!-- autofocus en el contenedor: al abrir, el foco no cae en el logo (evita el aro de foco sobre él) -->
  <div class="flex h-full flex-col outline-none" tabindex="-1" autofocus>
    <!-- 1. Logo + cerrar -->
    <div class="flex items-center justify-between border-b border-slate-100 px-4 py-1">
      <Logo variant="dark" />
      <button type="button" data-menu-close aria-label="Cerrar menú" class="grid h-10 w-10 place-items-center rounded-full bg-slate-100 text-mega-navy hover:bg-slate-200/80 cursor-pointer">
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 pb-6 pt-4">
      <!-- 2. Sucursal en una línea -->
      <button
        type="button"
        data-branch-open
        aria-haspopup="dialog"
        class="flex w-full items-center gap-3 rounded-2xl bg-slate-50 px-4 py-3 text-left ring-1 ring-slate-200/70 hover:bg-slate-100 cursor-pointer"
      >
        <Icon name="map-pin" class="h-5 w-5 shrink-0 text-mega-orange" />
        <span class="min-w-0 flex-1 leading-tight">
          <span class="block text-xs font-semibold text-slate-500">Promos en</span>
          <strong class="block truncate font-display text-base font-bold" data-branch-current>{sucursales.default}</strong>
        </span>
        <span class="font-display text-sm font-bold text-mega-orange-dark">Cambiar</span>
      </button>

      <!-- 3. Lo que vende: filas grandes -->
      <nav aria-label={nav.menuLabel} class="mt-3">
        <ul>
          {
            primary.map((l) => (
              <li>
                <a
                  href={getHref(l.href)}
                  aria-current={isCurrent(l.href) ? "page" : undefined}
                  class:list={[
                    "flex h-14 items-center justify-between border-b border-slate-100 px-1 font-display text-[17px] font-bold",
                    isCurrent(l.href) ? "text-mega-orange-dark" : "text-mega-navy",
                  ]}
                >
                  {l.label}
                  <Icon name="chevron-down" class="h-5 w-5 -rotate-90 text-slate-300" />
                </a>
              </li>
            ))
          }
        </ul>

        <!-- 4. Consulta: cuadrícula de iconos -->
        <p class="mb-2.5 mt-6 px-1 text-[11px] font-black uppercase tracking-wider text-slate-400">Consulta</p>
        <ul class="grid grid-cols-3 gap-2">
          {
            tiles.map((l) => (
              <li>
                <a
                  href={getHref(l.href)}
                  target={isExternal(l) ? "_blank" : undefined}
                  rel={isExternal(l) ? "noopener noreferrer" : undefined}
                  aria-current={isCurrent(l.href) ? "page" : undefined}
                  class:list={[
                    "flex h-full flex-col items-center gap-2 rounded-2xl border px-1.5 py-3 text-center text-xs font-bold leading-tight",
                    isCurrent(l.href) ? "border-mega-orange/50 bg-orange-50 text-mega-orange-dark" : "border-slate-200 text-mega-navy hover:border-slate-300",
                  ]}
                >
                  <span class="grid h-10 w-10 place-items-center rounded-xl bg-orange-50 text-mega-orange-dark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={tileIcon(l.href)} />
                  </span>
                  {shortLabel[l.label] ?? l.label}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- 5. Ayuda: acordeón -->
        <details class="group/ayuda mt-6 border-y border-slate-100">
          <summary class="flex h-14 cursor-pointer list-none items-center justify-between px-1 font-display text-[17px] font-bold [&::-webkit-details-marker]:hidden">
            Ayuda
            <Icon name="chevron-down" class="h-5 w-5 text-slate-400 group-open/ayuda:rotate-180" />
          </summary>
          <ul class="pb-3">
            {
              ayuda.map((l) => (
                <li>
                  <a
                    href={getHref(l.href)}
                    target={isExternal(l) ? "_blank" : undefined}
                    rel={isExternal(l) ? "noopener noreferrer" : undefined}
                    aria-current={isCurrent(l.href) ? "page" : undefined}
                    class:list={["flex items-center gap-2 rounded-xl px-3 py-2.5 text-[15px] font-semibold hover:bg-slate-50", isCurrent(l.href) ? "text-mega-orange-dark" : "text-slate-700"]}
                  >
                    {l.label}
                    {isExternal(l) && <Icon name="external-link" class="h-3.5 w-3.5 text-slate-400" />}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </nav>
    </div>

    <!-- 6. Fijo abajo: venta + contacto -->
    <div class="border-t border-slate-100 px-4 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-3">
      <a
        href={whatsappUrl(nav.headerCta.whatsappText)}
        data-callme
        data-callme-label=""
        data-callme-interest="Menú celular - Cámbiate a Mega móvil"
        data-menu-close
        class="btn-primary h-12 w-full !py-0 !text-base !shadow-none"
      >
        {nav.headerCta.label}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <p class="mt-3 flex items-center justify-center gap-4 text-sm font-semibold text-slate-600">
        <a href={phone.href} class="inline-flex items-center gap-1.5 hover:text-mega-navy">
          <Icon name="phone" class="h-4 w-4 text-mega-orange" />
          {phone.number}
        </a>
        <span class="h-4 w-px bg-slate-200" aria-hidden="true"></span>
        <a href={site.whatsapp.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-mega-navy">
          <svg viewBox="0 0 24 24" class="h-4 w-4 text-[#25D366]" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4c-1-1.6-1.5-3.4-1.5-5.2C2.2 6.6 6.6 2.2 12 2.2c2.6 0 5.1 1 6.9 2.9 1.8 1.8 2.9 4.3 2.9 6.9 0 5.4-4.4 9.8-9.8 9.8z"/></svg>
          WhatsApp
        </a>
      </p>
    </div>
  </div>
</dialog>

<script>
  const menu = document.getElementById("mobile-menu") as HTMLDialogElement | null;
  if (menu) {
    const setOpen = (open: boolean) => {
      if (open) menu.showModal();
      else menu.close();
      document.querySelectorAll("[data-menu-open]").forEach((b) => b.setAttribute("aria-expanded", String(open)));
    };
    document.querySelectorAll("[data-menu-open]").forEach((b) => b.addEventListener("click", () => setOpen(true)));
    menu.querySelectorAll("[data-menu-close]").forEach((b) => b.addEventListener("click", () => setOpen(false)));
    menu.addEventListener("close", () => (document.documentElement.style.overflow = ""));
    menu.addEventListener("cancel", () => setOpen(false));
    // Bloquea el scroll de la página mientras el menú está abierto.
    new MutationObserver(() => (document.documentElement.style.overflow = menu.open ? "hidden" : "")).observe(menu, { attributes: true, attributeFilter: ["open"] });
    // Si se agranda a escritorio con el menú abierto, se cierra.
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => e.matches && menu.open && setOpen(false));
  }
</script>
