---
import faq from "../data/faq.json";
import Faq from "./Faq";
---

<section
  id="faq"
  aria-labelledby="faq-title"
  class="px-4 py-9 sm:px-6 lg:px-8 lg:py-14"
>
  <div class="mx-auto max-w-6xl">
    <div class="text-center mb-8">
      <h2
        id="faq-title"
        class="font-display text-3xl sm:text-4xl font-black uppercase tracking-tight text-mega-navy"
      >
        {faq.title}
      </h2>
    </div>

    <!-- Acordeón plano en 2 columnas (escritorio) -->
    <Faq
      client:visible
      items={faq.items.map(({ id, question, answer }) => ({
        id,
        question,
        answer,
      }))}
    />
  </div>
</section>
