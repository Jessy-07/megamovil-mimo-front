---
/**
 * "¡Llámame!" — modal del callcenter para los botones "¡Lo quiero!" de los planes (y "¡La quiero!" de promociones).
 *
 * Cómo se conecta (igual que el sitio actual):
 * - El script de Convertia / inConcert (site.json → callcenter.scriptUrl) busca al cargar la página los <form> con un campo
 *   de teléfono y los conecta a su "Click to Call": valida 10 dígitos, envía el número y muestra su aviso "¡¡Te llamaremos en breve!!".
 * - Por eso este formulario vive en el HTML desde el inicio (no se crea con React) y conserva los MISMOS ids del sitio actual:
 *   form #f-llamame-home2 · input #telefono1 (name="phone", data-ic-form-field="phone") · hidden #f-llamame-interes (name="interes")
 *   · botón #f-llamame-home2_0. Convertia reporta formId/buttonId: cambiarlos rompería los reportes del callcenter.
 * - Cada botón que abre el modal lleva data-callme, data-callme-label (lo que ve el usuario) y data-callme-interest
 *   (lo que recibe el asesor en "interes").
 * - Enlace de campaña: cualquier URL con #llamame abre el modal.
 * - Si Convertia no cargó (bloqueador, sin red, dominio no autorizado), no se pierde la venta: se ofrece WhatsApp con el
 *   plan y el número ya escritos.
 */
import site from "../data/site.json";

const { callcenter } = site;
---

<dialog
  id="callme-dialog"
  data-wa={site.whatsapp.href}
  aria-labelledby="callme-title"
  class="m-auto w-[calc(100%-2rem)] max-w-[460px] overflow-visible rounded-3xl bg-white p-0 text-mega-navy shadow-xl backdrop:bg-mega-navy/60 backdrop:backdrop-blur-sm"
>
  <!--
    Diseño limpio (una sola columna, centrada): icono redondo montado sobre el borde → título → frase → plan elegido (texto,
    sin etiqueta) → campo → botón a todo lo ancho → una línea de horario + términos → WhatsApp como salida discreta.
  -->
  <div class="relative px-6 pb-6 pt-14 text-center sm:px-9 sm:pb-8">
    <!-- Icono redondo, montado sobre el borde superior (azul: el naranja sólido se reserva al botón de venta) -->
    <span class="absolute left-1/2 top-0 grid h-[72px] w-[72px] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-mega-navy text-[#FF8A4C] ring-[6px] ring-white" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
      </svg>
    </span>

    <button
      type="button"
      data-callme-close
      aria-label="Cerrar"
      class="absolute right-3 top-3 grid h-9 w-9 place-items-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-mega-navy cursor-pointer"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
    </button>

    <!-- Paso 1: pedir el número -->
    <div data-callme-step="form">
      <h2 id="callme-title" class="font-display text-2xl font-black uppercase leading-tight tracking-tight">{callcenter.title}</h2>
      <p class="mx-auto mt-2 max-w-xs text-sm font-medium text-slate-600 sm:text-base">{callcenter.text}</p>

      <!-- El plan elegido NO se muestra aquí: viaja interno (campo "interes" para el asesor y texto de WhatsApp). -->

      <!-- IDs y nombres IGUALES al sitio actual (Convertia los usa para reportar) -->
      <form role="form" id="f-llamame-home2" class="mt-6" novalidate>
        <input type="hidden" id="f-llamame-interes" name="interes" value="" />
        <label for="telefono1" class="sr-only">{callcenter.label}</label>
        <input
          type="tel"
          id="telefono1"
          name="phone"
          data-ic-form-field="phone"
          class="telefono h-14 w-full rounded-full border-2 border-slate-200 bg-white px-5 text-center text-lg font-bold tracking-wider text-mega-navy placeholder:font-medium placeholder:tracking-normal placeholder:text-slate-400 focus:border-mega-orange focus:outline-none"
          placeholder={callcenter.label}
          inputmode="numeric"
          autocomplete="tel-national"
          maxlength="14"
          required
          aria-describedby="callme-error callme-hours"
        />
        <p id="callme-error" class="mt-2 text-sm font-bold text-red-700 empty:hidden" role="alert"></p>
        <button type="submit" id="f-llamame-home2_0" class="btn-llamar btn-primary mt-3 h-14 w-full !shadow-none">{callcenter.button}</button>
      </form>

      <p id="callme-hours" class="mt-3 text-balance text-xs font-medium text-slate-500">
        {callcenter.hours}
        <a href={callcenter.termsHref} target="_blank" rel="noopener noreferrer" class="whitespace-nowrap underline underline-offset-2 hover:text-mega-navy">Aplican términos</a>
      </p>

      <!-- ¿Prefieres escribir? Igual que la franja del Home: divisor "o" + botón aparte con contorno y texto ("Escríbenos"),
           para que no se confunda con "¡Llámame!". -->
      <div class="mt-4 flex items-center gap-3" aria-hidden="true">
        <span class="h-px flex-1 bg-slate-200"></span>
        <span class="text-xs font-bold uppercase text-slate-400">o</span>
        <span class="h-px flex-1 bg-slate-200"></span>
      </div>
      <a
        href={site.whatsapp.href}
        target="_blank"
        rel="noopener noreferrer"
        data-callme-whatsapp
        aria-label={callcenter.whatsappLabel}
        class="mt-4 inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border-2 border-slate-200 font-display text-sm font-extrabold text-mega-navy hover:border-[#25D366] hover:bg-[#25D366]/5"
      >
          <svg viewBox="0 0 24 24" class="h-5 w-5 text-[#25D366]" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4c-1-1.6-1.5-3.4-1.5-5.2C2.2 6.6 6.6 2.2 12 2.2c2.6 0 5.1 1 6.9 2.9 1.8 1.8 2.9 4.3 2.9 6.9 0 5.4-4.4 9.8-9.8 9.8z"/></svg>
        {site.callStrip.whatsappButton}
      </a>
    </div>

    <!-- Si el callcenter no está disponible: WhatsApp con todo ya escrito -->
    <div data-callme-step="fallback" hidden>
      <h2 class="font-display text-2xl font-black uppercase leading-tight tracking-tight">{callcenter.fallbackTitle}</h2>
      <p class="mx-auto mt-2 max-w-sm text-sm font-medium text-slate-600 sm:text-base">{callcenter.fallbackText}</p>
      <a
        href={site.whatsapp.href}
        target="_blank"
        rel="noopener noreferrer"
        data-callme-fallback-link
        class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-6 py-4 font-display text-base font-black text-white hover:bg-[#20ba5a]"
      >
        {callcenter.fallbackButton}
      </a>
    </div>
  </div>
</dialog>

<!--
  Carga del callcenter DESPUÉS de que la página terminó de cargar (no frena la página):
  jQuery → Bootstrap JS (copia de Convertia) → script de Convertia.
  Por qué jQuery y Bootstrap: si la página no los trae, Convertia intenta bajar "static/libs/5.min.js", que no existe (404),
  y el Click to Call nunca se activa. El sitio actual funciona porque ya carga ambos. Solo JS: no se carga CSS de Bootstrap.
-->
{
  callcenter.enabled && (
    <script is:inline define:vars={{ libs: callcenter.libs, main: callcenter.scriptUrl }}>
      (function () {
        var load = function (src, cb) {
          var s = document.createElement("script");
          s.src = src;
          s.onload = cb;
          s.onerror = cb;
          document.body.appendChild(s);
        };
        var start = function () {
          var chain = libs.slice();
          if (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal) chain = [];
          else if (window.jQuery) chain = chain.slice(1);
          (function next() {
            if (chain.length) load(chain.shift(), next);
            else load(main);
          })();
        };
        var idle = function () {
          (window.requestIdleCallback || function (f) { setTimeout(f, 300); })(start);
        };
        if (document.readyState === "complete") idle();
        else window.addEventListener("load", idle, { once: true });
      })();
    </script>
  )
}

<script>
  import { setupCallForm } from "../scripts/callForm";

  const dialog = document.getElementById("callme-dialog") as HTMLDialogElement | null;
  const form = document.getElementById("f-llamame-home2") as HTMLFormElement | null;
  const phone = document.getElementById("telefono1") as HTMLInputElement | null;
  const interest = document.getElementById("f-llamame-interes") as HTMLInputElement | null;
  const submitBtn = document.getElementById("f-llamame-home2_0") as HTMLButtonElement | null;
  const error = document.getElementById("callme-error");
  const stepForm = dialog?.querySelector<HTMLElement>('[data-callme-step="form"]');
  const stepFallback = dialog?.querySelector<HTMLElement>('[data-callme-step="fallback"]');
  const waLink = dialog?.querySelector<HTMLAnchorElement>("[data-callme-whatsapp]");
  const waFallback = dialog?.querySelector<HTMLAnchorElement>("[data-callme-fallback-link]");
  const WA = dialog?.dataset.wa ?? "https://wa.me/523396900001";
  let currentLabel = "";

  const waText = (digits = "") =>
    `Hola, quiero contratar ${currentLabel ? `el plan ${currentLabel}` : "un plan Mega móvil"}.${digits ? ` Mi número es ${digits}.` : ""}`;
  const waHref = (digits = "") => `${WA}?text=${encodeURIComponent(waText(digits))}`;

  const close = () => dialog?.close();

  const callForm =
    form && phone
      ? setupCallForm(form, phone, submitBtn, {
          // Válido y conectado: se cierra el modal para que se vea el aviso de Convertia.
          onSend: close,
          onFallback: (digits) => {
            if (waFallback) waFallback.href = waHref(digits);
            if (stepForm) stepForm.hidden = true;
            if (stepFallback) stepFallback.hidden = false;
          },
          onError: (message) => {
            if (error) error.textContent = message;
          },
        })
      : null;

  const open = (label: string, interestValue: string) => {
    if (!dialog || !phone || !interest) return false;
    currentLabel = label;
    interest.value = interestValue;
    if (waLink) waLink.href = waHref();
    if (stepForm) stepForm.hidden = false;
    if (stepFallback) stepFallback.hidden = true;
    callForm?.clearError();
    dialog.showModal();
    document.documentElement.style.overflow = "hidden";
    phone.focus();
    return true;
  };

  dialog?.addEventListener("close", () => (document.documentElement.style.overflow = ""));
  dialog?.querySelector("[data-callme-close]")?.addEventListener("click", close);
  // Clic en el fondo oscuro cierra.
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) close();
  });

  // Cualquier botón con data-callme abre el modal (su href queda como respaldo sin JavaScript: WhatsApp).
  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>("[data-callme]");
    if (!trigger) return;
    if (open(trigger.dataset.callmeLabel ?? "", trigger.dataset.callmeInterest ?? "")) e.preventDefault();
  });

  // Enlace directo para campañas: cualquier página + #llamame abre el modal (sin plan elegido).
  if (location.hash === "#llamame") open("", "Enlace #llamame - " + location.pathname);
</script>
