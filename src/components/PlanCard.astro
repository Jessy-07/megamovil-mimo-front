---
import SocialIcon from './SocialIcon.astro';

interface Plan {
  slug: string;
  name: string;
  lines?: number;
  gigasDetail?: string;
  gigas?: string;
  gigasUnit?: string;
  speedTag?: string;
  highlight: { value: string; unit: string };
  detail: string;
  price: number;
  pricePerLine?: string;
  savings?: string;
  badge: string | null;
  featured: boolean;
  colorTone?: string;
  mascot: string | null;
  socialApps?: string[];
  legal: string;
}

interface Props {
  plan: Plan;
  ctaLabel: string;
  perMonth: string;
}

const { plan, ctaLabel, perMonth } = Astro.props;
const isFamily = Boolean(plan.lines && plan.lines > 1);
const isUnlimited = plan.gigas === 'ILIMITADO' || plan.highlight.value === '∞';
---

<div id={`plan-${plan.slug}`} class="relative h-full flex flex-col group transition-all duration-300">
  <!-- Etiqueta de destacado FUERA de la card para que todas las cards tengan exactamente el mismo tamaño y alineación -->
  {plan.badge && (
    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 z-20 whitespace-nowrap pointer-events-none">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-mega-orange to-[#FF7020] px-4 py-1 font-display text-[11px] sm:text-xs font-black uppercase tracking-wider text-white shadow-orange-sm ring-2 ring-white">
        <svg class="h-3 w-3 fill-current text-white shrink-0" viewBox="0 0 24 24">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
        <span>{plan.badge}</span>
      </span>
    </div>
  )}

  <article
    class:list={[
      'relative z-10 flex h-full flex-col justify-between overflow-hidden rounded-3xl bg-white transition-all duration-200 hover:-translate-y-1',
      plan.featured
        ? 'border-2 border-mega-orange shadow-card-hover ring-1 ring-mega-orange/30'
        : 'border border-slate-200/90 shadow-card-clean hover:border-mega-orange/60 hover:shadow-lg',
    ]}
  >
    <div class="p-6 flex-1 flex flex-col justify-between">
      <div>
        <!-- Nombre del plan en tipografía limpia (exactamente a la misma altura en todas las cards) -->
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <span class="font-display text-xs font-black uppercase tracking-wider text-slate-500">
            {plan.name}
          </span>
        </div>

      <!-- BLOQUE PROTAGONISTA: Líneas o Gigas con el Naranja Mega móvil como acento -->
      <div class="my-5 rounded-2xl bg-gradient-to-b from-slate-50/90 to-orange-50/20 p-5 text-center border border-slate-100">
        {isFamily ? (
          <div>
            <div class="flex items-baseline justify-center gap-2">
              <span class="font-display text-6xl sm:text-7xl font-black tracking-tight text-mega-navy leading-none">
                {plan.lines}
              </span>
              <span class="font-display text-2xl font-black uppercase tracking-wide text-mega-orange">
                Líneas
              </span>
            </div>

            <!-- Sticker destacado de ahorro comercial -->
            {(plan.savings || plan.pricePerLine) && (
              <div class="my-2.5 inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-mega-orange to-[#FF7020] px-3.5 py-1 font-display text-xs font-black uppercase tracking-wider text-white shadow-orange-sm">
                <span>{plan.savings || `Sale a ${plan.pricePerLine} por línea`}</span>
              </div>
            )}

            <!-- Desglose de líneas y gigas -->
            <p class="mt-1 text-lg font-bold text-slate-600 leading-snug">
              {plan.gigasDetail}
            </p>
          </div>
        ) : isUnlimited ? (
          <div class="py-2.5">
            <div class="flex items-center justify-center">
              <span class="font-display text-4xl sm:text-5xl font-black tracking-tight text-mega-navy leading-none">
                ILIMITADO
              </span>
            </div>
          </div>
        ) : (
          <div class="py-1">
            <div class="flex items-baseline justify-center gap-1.5">
              <span class="font-display text-6xl sm:text-7xl font-black tracking-tight text-mega-navy leading-none">
                {plan.gigas || plan.highlight.value}
              </span>
              <span class="font-display text-2xl sm:text-3xl font-black text-mega-orange">
                GB
              </span>
            </div>
          </div>
        )}
      </div>

      <!-- REDES SOCIALES INCLUIDAS: Diferenciadas para planes individuales -->
      {!isFamily && plan.socialApps && plan.socialApps.length > 0 && (
        <div class="mt-3.5 rounded-xl bg-slate-50/90 border border-slate-100 p-2.5 text-center">
          <p class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-2">
            {isUnlimited ? 'Todas las redes incluidas:' : 'Redes sociales incluidas:'}
          </p>
          <div class="flex items-center justify-center gap-1.5 flex-wrap">
            {plan.socialApps.map((slug) => (
              <span
                class="grid h-6 w-6 place-items-center rounded-full bg-white text-slate-700 shadow-2xs border border-slate-200/80 transition-transform hover:scale-110 hover:text-mega-orange"
                title={slug.toUpperCase()}
              >
                <SocialIcon slug={slug} class="h-3.5 w-3.5" />
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- SECCIÓN DE PRECIO & BOTÓN CTA NARANJA -->
      <div class="mt-4 border-t border-slate-100 pt-4 text-center">
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">
          Por solo
        </span>
        <div class="flex items-baseline justify-center gap-0.5 text-mega-navy">
          <span class="font-display text-2xl font-black text-slate-700">$</span>
          <span class="font-display text-4xl sm:text-5xl font-black tracking-tight leading-none text-mega-navy">
            {plan.price}
          </span>
          <span class="font-sans text-sm font-extrabold text-slate-500">
            {perMonth}
          </span>
        </div>

        <!-- Botón Naranja Protagonista ¡Lo quiero! -->
        <a
          href={`/contratar?plan=${plan.slug}`}
          class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-mega-orange via-[#FF6614] to-mega-orange-dark py-3.5 px-4 font-display text-base font-black uppercase tracking-wider text-white shadow-orange-glow transition-all duration-200 hover:-translate-y-0.5 hover:brightness-105 active:translate-y-0 active:scale-95"
        >
          <span>{ctaLabel}</span>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Pie de tarjeta en franja limpia con vigencia/condición -->
    <div class="bg-slate-50/80 px-4 py-2.5 text-center text-[10px] font-extrabold text-slate-500 tracking-tight border-t border-slate-100">
      {plan.legal}
    </div>
  </article>
</div>
