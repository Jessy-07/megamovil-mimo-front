---
/**
 * Tarjeta de plan (familiar o individual). Lo que se destaca: los GIGAS y el PRECIO; después, qué plan es.
 * - Encabezado: solo en familiares ("2 líneas"). Sin "PLAN FAMILIAR/INDIVIDUAL" ni nombres en individuales. SIN etiquetas:
 *   el destacado (featured) se distingue por ir en azul oscuro (misma altura que las demás).
 * - Todo lo "ilimitado" lleva un asterisco pequeño (el detalle está en las políticas de uso).
 * - Lo que incluyen TODOS los planes del grupo va una sola vez arriba de las tarjetas (Plans.astro), y el legal, una sola
 *   vez debajo. Aquí solo lo que cambia entre planes.
 * - "¡Lo quiero!" (único naranja sólido de la tarjeta) abre el modal "¡Llámame!" del callcenter (CallMeModal, data-callme);
 *   sin JavaScript, su href es WhatsApp. Al lado, WhatsApp discreto para dudas.
 */
import SocialIcon from './SocialIcon.astro';
import SocialBrand from './SocialBrand.astro';
import plansData from '../data/plans.json';
import { planSummary, whatsappUrl } from '../utils/whatsapp';

interface Plan {
  slug: string;
  name: string;
  shortName: string;
  lines?: number;
  gigasDetail?: string;
  gigas?: string;
  totalGb?: string;
  highlight: { value: string; unit: string };
  price: number;
  pricePerLineLabel?: string;
  savings?: string;
  featured: boolean;
  detail?: string;
  socialApps?: string[];
}

interface Props {
  plan: Plan;
  kind: 'family' | 'individual';
  /** "PLAN FAMILIAR" / "PLAN INDIVIDUAL" */
  kindLabel: string;
  /** "en total" / "para navegar" */
  unitLabel: string;
  ctaLabel: string;
  perMonth: string;
  /** Respaldo sin JavaScript (por defecto WhatsApp con el plan escrito). */
  ctaHref?: string;
}

const summary = planSummary(Astro.props.plan);
const { plan, kind, kindLabel, unitLabel, ctaLabel, perMonth, ctaHref = whatsappUrl(`Hola, quiero contratar el plan ${summary}.`) } = Astro.props;
const dark = plan.featured;
const isUnlimited = plan.gigas === 'ILIMITADO';
const gb = kind === 'family' ? plan.totalGb : plan.gigas;
// Familiares: en lugar de los gigas totales se muestra el reparto, p. ej. "1 línea de 38 GB" y "3 líneas de 7 GB".
// Se saca de gigasDetail ("1 línea de 38 GB + 3 de 7 GB"); si no se puede leer, se usa el diseño anterior (gigas totales).
const split =
  kind === 'family' && plan.gigasDetail
    ? plan.gigasDetail
        .split('+')
        .map((part) => part.trim().match(/^(\d+)\s+(?:l[ií]neas?\s+)?de\s+(\d+)\s*GB$/i))
        .map((m) => (m ? { lines: Number(m[1]), gb: m[2] } : null))
    : [];
const splitRows = split.length > 0 && split.every(Boolean) ? (split as { lines: number; gb: string }[]) : null;
const askHref = whatsappUrl(`Hola, tengo dudas sobre el plan ${summary}.`);

// Redes del plan (individuales): se muestran solo las que SÍ incluye.
const allApps = plansData.socialApps;
const included = new Set(plan.socialApps ?? []);
// Sin conteos ni 'todas': siempre el mismo texto (los logos muestran cuáles incluye).
const socialTitle = 'Redes sociales ilimitadas';
---

<article
  id={`plan-${plan.slug}`}
  class:list={[
    'relative flex h-full flex-col overflow-hidden rounded-3xl p-6 sm:p-7',
    // Destacado: azul oscuro (misma altura que las demás). Sin etiquetas.
    dark
      ? 'bg-mega-navy text-white shadow-[0_18px_40px_-12px_rgba(6,22,48,0.45)]'
      : 'border border-slate-200 bg-white text-mega-navy',
  ]}
>
  {dark && <div class="pointer-events-none absolute -bottom-16 -right-16 h-48 w-48 rounded-full border-[18px] border-white/[0.04]" aria-hidden="true" />}

  <!-- Encabezado: solo en familiares ("2 líneas"). En individuales no va nombre: la oferta son los gigas + el precio. -->
  {
    kind === 'family' ? (
      <h3 class="relative flex items-center gap-2 font-display text-xl font-extrabold leading-tight">
        <svg viewBox="0 0 24 24" class:list={['h-5 w-5 shrink-0', dark ? 'text-[#FF8A4C]' : 'text-mega-orange']} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
        {plan.shortName}
      </h3>
    ) : (
      <h3 class="sr-only">{`${kindLabel} ${plan.shortName}`}</h3>
    )
  }

  <!-- GIGAS (lo más grande de la tarjeta) -->
  <div class:list={['relative', kind === 'family' ? 'mt-5' : 'min-h-[5rem]']}>
    {
      splitRows ? (
        // Reparto en dos renglones: "1 línea de 38 GB" / "3 líneas de 7 GB". Todo del mismo tamaño; solo cambia el grosor (los gigas en negritas).
        <div class="space-y-0.5 font-display text-[1.65rem] leading-tight tracking-tight sm:text-3xl">
          {splitRows.map((r) => (
            <p class="flex items-baseline gap-2">
              <span class:list={['min-w-[9.5rem] font-normal sm:min-w-[10.75rem]', dark ? 'text-white' : 'text-mega-navy']}>
                {r.lines} {r.lines === 1 ? 'línea' : 'líneas'} de
              </span>
              <span class="font-extrabold">{r.gb}</span>
              <span class:list={['-ml-1 font-extrabold', dark ? 'text-[#FF8A4C]' : 'text-mega-orange-dark']}>GB</span>
            </p>
          ))}
        </div>
      ) : isUnlimited ? (
        <p class="font-display text-[2.6rem] font-extrabold leading-[0.95] tracking-tight">
          Gigas <span class={dark ? 'text-[#FF8A4C]' : 'text-mega-orange-dark'}>ilimitados<sup class="relative -top-[0.3em] ml-px align-baseline text-[0.6em] font-bold">*</sup></span>
        </p>
      ) : (
        <p class="flex items-baseline gap-1.5">
          <span class="font-display text-6xl font-extrabold leading-none tracking-tight">{gb}</span>
          <span class:list={['font-display text-3xl font-extrabold', dark ? 'text-[#FF8A4C]' : 'text-mega-orange-dark']}>GB</span>
          <span class:list={['ml-1 text-sm font-semibold', dark ? 'text-slate-300' : 'text-slate-500']}>{unitLabel}</span>
        </p>
      )
    }
  </div>

  <!-- Familiares: reparto de gigas y separador. Individuales: el precio va JUNTO a los gigas ("7 GB · por solo $100"). -->
  {
    kind === 'family' && (
      <>
        {!splitRows && (
          <p class:list={['relative mt-3 text-[15px] font-semibold', dark ? 'text-slate-200' : 'text-slate-600']}>{plan.gigasDetail}</p>
        )}
        <hr class:list={['relative my-5 border-t', dark ? 'border-white/10' : 'border-slate-200']} />
      </>
    )
  }

  <!-- PRECIO -->
  <div class:list={['relative', kind === 'individual' && 'mt-4']}>
    <p class:list={['text-xs font-bold uppercase tracking-[0.12em]', dark ? 'text-slate-300' : 'text-slate-500']}>Por solo</p>
    <p class="mt-0.5 flex items-start gap-0.5">
      <span class="mt-1.5 font-display text-2xl font-extrabold">$</span>
      <span class="font-display text-5xl font-extrabold leading-none tracking-tight">{plan.price}</span>
      <span class:list={['ml-1 self-end pb-1 text-base font-semibold', dark ? 'text-slate-300' : 'text-slate-500']}>{perMonth}</span>
    </p>
    {/* Familiares: solo el ahorro (en verde, como texto, sin etiqueta) */}
    {kind === 'family' && plan.savings && (
      <p class:list={['mt-2 text-sm font-bold', dark ? 'text-emerald-300' : 'text-emerald-700']}>{plan.savings}</p>
    )}
  </div>

  <!-- Individuales: redes incluidas debajo del precio (solo las que SÍ incluye); los botones quedan al final de la tarjeta -->
  {
    kind === 'individual' && (
      <div class:list={['relative mt-5 border-t pt-4', dark ? 'border-white/10' : 'border-slate-200']}>
        <p class:list={['text-xs font-bold', dark ? 'text-slate-200' : 'text-slate-600']}>
          {socialTitle}
          <sup class="relative -top-[0.3em] ml-px align-baseline text-[0.6em] font-bold">*</sup>
        </p>
        <ul class="mt-2 flex flex-wrap gap-1" aria-label={socialTitle}>
          {allApps
            .filter((app) => included.has(app.slug))
            .map((app) => (
              <li>
                <SocialBrand slug={app.slug} class="h-6 w-6" />
              </li>
            ))}
        </ul>
      </div>
    )
  }

  <!-- Acciones: ¡Lo quiero! (callcenter) + WhatsApp discreto para dudas -->
  <div class="relative mt-auto flex items-center gap-2.5 pt-6">
    <a
      href={ctaHref}
      data-callme
      data-callme-label={summary}
      data-callme-interest={`${summary} - ${plan.slug}`}
      class="inline-flex h-12 flex-1 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-mega-orange px-5 font-display text-[19px] font-extrabold text-white hover:bg-mega-orange-dark"
    >
      {ctaLabel}
    </a>
    <a
      href={askHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Preguntar por el plan ${plan.shortName} por WhatsApp`}
      title="¿Dudas? Pregúntanos por WhatsApp"
      class:list={[
        'grid h-12 w-12 shrink-0 place-items-center rounded-full',
        dark ? 'bg-white/10 text-[#25D366] hover:bg-white/15' : 'bg-[#25D366]/10 text-[#1DA851] ring-1 ring-[#25D366]/25 hover:bg-[#25D366]/15',
      ]}
    >
      <SocialIcon slug="whatsapp" class="h-5 w-5" />
    </a>
  </div>

</article>
