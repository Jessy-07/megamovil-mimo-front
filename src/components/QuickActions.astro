---
const actions = [
  {
    icon: "repeat",
    title: "Cámbiate con tu número",
    badge: "Portabilidad 24h",
    href: "#planes",
    iconBg: "bg-mega-orange text-white",
  },
  {
    icon: "smartphone",
    title: "Valida tu equipo",
    badge: "Checa IMEI",
    href: "#compatibilidad",
    iconBg: "bg-mega-blue text-white",
  },
];
---

<section
  aria-label="Accesos rápidos"
  class="relative z-20 -mt-5 sm:-mt-6 px-4 sm:px-6"
>
  <!-- Contenedor centrado y limpio para 2 acciones -->
  <div class="mx-auto w-full max-w-[640px]">
    <div class="rounded-2xl sm:rounded-full bg-white border border-slate-200 shadow-sm p-1.5 sm:p-2">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 sm:gap-2">
        {
          actions.map((act) => (
            <a
              href={act.href}
              target={act.href.startsWith("http") ? "_blank" : undefined}
              rel={act.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="group relative flex items-center justify-between gap-2.5 rounded-full px-4 py-2.5 hover:bg-slate-50 transition-colors cursor-pointer"
            >
              <!-- Icono y Textos -->
              <div class="flex items-center gap-3 min-w-0">
                <span
                  class:list={[
                    "grid h-9 w-9 sm:h-9.5 sm:w-9.5 shrink-0 place-items-center rounded-full text-white transition-transform duration-150 group-hover:scale-105",
                    act.iconBg,
                  ]}
                >
                  {act.icon === "repeat" && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M17 1l4 4-4 4" />
                      <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                      <path d="M7 23l-4-4 4-4" />
                      <path d="M21 13v2a4 4 0 0 1-4 4H3" />
                    </svg>
                  )}
                  {act.icon === "smartphone" && (
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
                      <line x1="12" y1="18" x2="12.01" y2="18" stroke-width="3" />
                    </svg>
                  )}
                </span>

                <div class="flex flex-col min-w-0">
                  <span class="font-display text-xs sm:text-[13px] font-black uppercase tracking-tight text-mega-navy group-hover:text-mega-orange transition-colors">
                    {act.title}
                  </span>
                  <span class="text-[10px] sm:text-[11px] font-bold text-slate-500">
                    {act.badge}
                  </span>
                </div>
              </div>

              <!-- Indicador de acción (Flecha suave sin sombras) -->
              <span class="grid h-6 w-6 sm:h-7 sm:w-7 shrink-0 place-items-center rounded-full bg-slate-100 text-slate-400 group-hover:bg-mega-orange group-hover:text-white transition-colors">
                <svg class="h-3 w-3 sm:h-3.5 sm:w-3.5 transition-transform duration-150 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
