---
import plans from '../data/plans.json';
import site from '../data/site.json';
import Mimo from './Mimo.astro';

const minPrice = Math.min(...Object.values(plans.groups).flatMap((g) => g.plans.map((p) => p.price)));
const { stickyBar } = site;
---

<!-- WhatsApp: avatar circular con Mimo -->
<a
  href={site.whatsapp.href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={site.whatsapp.label}
  class="fixed bottom-20 right-4 z-50 grid h-14 w-14 place-items-center rounded-full bg-white shadow-card-hover ring-[3px] ring-[#25D366] transition hover:scale-105 sm:bottom-6 sm:right-6 sm:h-16 sm:w-16"
>
  <span class="grid h-full w-full place-items-center overflow-hidden rounded-full">
    <Mimo pose="head" size="sm" decorative shadow={false} class="!h-11 translate-y-1 sm:!h-12" />
  </span>
  <span class="absolute -right-1 -top-1 grid h-6 w-6 place-items-center rounded-full bg-[#25D366] text-white">
    <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true"><path d="M12.03 0C5.4 0 .01 5.39.01 12.02c0 2.12.55 4.19 1.6 6.01L0 24l6.16-1.61a12 12 0 0 0 5.87 1.5c6.63 0 12.02-5.39 12.02-12.02S18.67 0 12.03 0zm5.5 14.36c-.3-.15-1.79-.88-2.06-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.96 1.18-.18.2-.35.23-.65.08-.3-.15-1.28-.47-2.43-1.5-.9-.8-1.5-1.79-1.68-2.09-.18-.3-.02-.47.13-.62.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.24-.24-.59-.49-.51-.68-.52h-.58c-.2 0-.53.08-.8.38-.28.3-1.06 1.03-1.06 2.52s1.08 2.92 1.23 3.12c.15.2 2.13 3.25 5.16 4.56 3.03 1.3 3.03.87 3.58.82.55-.05 1.79-.73 2.04-1.43.25-.7.25-1.31.18-1.43-.08-.13-.28-.2-.58-.35z"/></svg>
  </span>
</a>

<!-- Barra inferior sticky (solo móvil) -->
<div class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-between gap-3 border-t border-mega-gray-dark/15 bg-white/95 px-4 py-2.5 shadow-[0_-8px_24px_-12px_rgb(7_21_46/0.3)] backdrop-blur sm:hidden">
  <p class="leading-none">
    <span class="text-xs font-bold text-mega-gray-dark">{stickyBar.prefix}</span><br />
    <span class="text-3xl font-black text-mega-navy">${minPrice}</span><span class="text-sm font-extrabold text-mega-gray-dark">{plans.perMonth}</span>
  </p>
  <a href={stickyBar.cta.href} class="btn-primary !px-8 !py-3">{stickyBar.cta.label}</a>
</div>

