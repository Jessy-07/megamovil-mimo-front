---
import plans from "../data/plans.json";
import site from "../data/site.json";
import { resolveAnchor } from "../utils/links";

const minPrice = Math.min(
  ...Object.values(plans.groups).flatMap((g) => g.plans.map((p) => p.price)),
);
const { stickyBar } = site;
// #planes → /planes fuera del Home (ver utils/links.ts).
const stickyHref = resolveAnchor(stickyBar.cta.href, Astro.url.pathname);

interface Props {
  /**
   * Barra fija del celular con otra acción (p. ej. Recargas: "Recarga marcando *1234" + "Marcar").
   * Sin esta prop, la barra vende planes ("Desde $X/mes" + "¡Lo quiero!" + WhatsApp), como en todo el sitio.
   */
  bar?: { prefix: string; value: string; ctaLabel: string; ctaHref: string };
}
const { bar } = Astro.props;
---

<!-- WhatsApp flotante con animación de Mimo saludando. SOLO desde sm (tablet/escritorio): en celular no hay burbuja de WhatsApp
     (decisión del usuario: un solo globo en pantalla); WhatsApp va dentro de la barra fija, la franja, el popup y el footer. -->
<a
  href={site.whatsapp.href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={site.whatsapp.label}
  class="mimo-wa-fab group fixed bottom-3 right-3.5 z-50 hidden transition-transform sm:block duration-200 hover:-translate-y-1 active:translate-y-0 active:scale-95 sm:bottom-6 sm:right-6"
>
  <!-- Tooltip en Hover: ¡Contrata aquí! -->
  <div
    class="pointer-events-none absolute right-full top-1/2 -translate-y-1/2 mr-3 opacity-0 translate-x-2 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-0 z-30"
  >
    <div
      class="relative whitespace-nowrap rounded-full bg-[#0A1E3D] px-3.5 py-1.5 text-xs font-black text-white shadow-xl border border-white/10"
    >
      <span>¡Contrata aquí!</span>
      <!-- Flecha indicadora apuntando hacia Mimo -->
      <span
        class="absolute left-full top-1/2 -translate-y-1/2 border-y-[5px] border-y-transparent border-l-[6px] border-l-[#0A1E3D]"
      ></span>
    </div>
  </div>

  <!-- Botón circular 4rem x 4rem con Video HD sin distorsión -->
  <div
    class="relative h-16 w-16 rounded-full bg-white ring-[2.5px] ring-[#25D366] shadow-[0_8px_20px_rgba(0,0,0,0.18)] transition-all duration-200 group-hover:shadow-[0_12px_28px_rgba(37,211,102,0.35)] group-hover:ring-[3px] overflow-hidden"
    style="transform: translateZ(0); -webkit-backface-visibility: hidden; backface-visibility: hidden;"
  >
    <video
      id="mimo-whatsapp-video"
      autoplay
      muted
      playsinline
      disablepictureinpicture
      disableremoteplayback
      class="h-full w-full object-cover pointer-events-none select-none"
      style="transform: translateZ(0); -webkit-backface-visibility: hidden; backface-visibility: hidden;"
    >
      <source src="/assets/video/mimo-whatssap-saludo.mp4" type="video/mp4" />
      <source src="/assets/video/mimo-whatssap-saludo.webm" type="video/webm" />
    </video>
  </div>

  <!-- Badge WhatsApp en la esquina superior derecha con logo oficial Font Awesome -->
  <span
    class="absolute -right-2 -top-1 grid h-6 w-6 place-items-center rounded-full bg-[#25D366] text-white shadow-md ring-2 ring-white z-20 pointer-events-none transition-transform duration-200 group-hover:scale-110"
  >
    <svg
      viewBox="0 0 448 512"
      fill="currentColor"
      class="h-3.5 w-3.5"
      aria-hidden="true"
    >
      <path
        d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
      ></path>
    </svg>
  </span>
</a>

<!--
  Barra inferior sticky (solo móvil): precio "desde" + "¡Lo quiero!" (único naranja sólido) + WhatsApp (círculo discreto, a la derecha).
  Siempre fija (decisión del usuario), con una × pequeña para cerrarla SOLO en esta vista: al recargar o cambiar de página vuelve.
  Al cerrarla, el Mimo de la promo baja a la esquina (queda un solo globo).
  "¡Lo quiero!" abre el popup "¡Llámame!" del callcenter (data-callme); sin JavaScript, su href lleva a los planes.
-->
<div
  id="sticky-bar"
  class="mm-sticky-bar fixed inset-x-0 bottom-0 z-40 flex items-center justify-between gap-3 border-t border-mega-gray-dark/15 bg-white/95 px-4 pt-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] shadow-[0_-8px_24px_-12px_rgb(7_21_46/0.3)] backdrop-blur sm:hidden"
>
  <!-- Cerrar (pequeño, sobre el borde superior) -->
  <button
    type="button"
    data-sticky-close
    aria-label="Cerrar barra"
    class="absolute -top-3 right-2 grid h-6 w-6 place-items-center rounded-full bg-white text-slate-500 ring-1 ring-slate-200 shadow-sm cursor-pointer"
  >
    <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
  </button>
  {bar ? (
    <>
      <p class="leading-none">
        <span class="text-xs font-bold text-mega-gray-dark">{bar.prefix}</span><br />
        <span class="text-3xl font-black text-mega-navy">{bar.value}</span>
      </p>
      <a href={bar.ctaHref} class="btn-primary h-12 shrink-0 !px-6 !py-0 !text-base !shadow-none">{bar.ctaLabel}</a>
    </>
  ) : (
  <>
  <p class="leading-none">
    <span class="text-xs font-bold text-mega-gray-dark">{stickyBar.prefix}</span
    ><br />
    <span class="text-3xl font-black text-mega-navy">${minPrice}</span><span
      class="text-sm font-extrabold text-mega-gray-dark">{plans.perMonth}</span
    >
  </p>
  <div class="flex shrink-0 items-center gap-2">
    <a href={stickyHref} data-callme data-callme-label="" data-callme-interest={`Barra fija celular - ¡Lo quiero! (desde $${minPrice})`} class="btn-primary h-12 !px-6 !py-0 !text-base !shadow-none">{stickyBar.cta.label}</a>
    <a
      href={site.whatsapp.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={site.whatsapp.label}
      class="grid h-12 w-12 place-items-center rounded-full border-2 border-slate-200 bg-white text-[#25D366] active:scale-95"
    >
      <svg viewBox="0 0 448 512" fill="currentColor" class="h-6 w-6" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" /></svg>
    </a>
  </div>
  </>
  )}
</div>

<script>
  // Barra fija (celular): la × la cierra solo en esta vista (al recargar o cambiar de página vuelve a salir).
  document.querySelector("[data-sticky-close]")?.addEventListener("click", () => {
    document.documentElement.classList.add("mm-sticky-closed");
  });

  const video = document.getElementById("mimo-whatsapp-video");

  if (video instanceof HTMLVideoElement) {
    let playCount = 1;
    const maxPlays = 2;
    // Frame exacto con la mano arriba saludando y sonriendo fijamente
    const freezeTime = 3.3;
    let isFrozen = false;

    const freezeOnGreeting = () => {
      if (isFrozen) return;
      isFrozen = true;
      video.pause();
      try {
        video.currentTime = freezeTime;
      } catch {
        /* Ignorar errores de seek en buffers cerrados */
      }
    };

    const checkProgress = () => {
      if (isFrozen) return;
      if (playCount >= maxPlays && video.currentTime >= freezeTime) {
        freezeOnGreeting();
        return;
      }
      if (!video.paused && !video.ended) {
        requestAnimationFrame(checkProgress);
      }
    };

    video.addEventListener("play", () => {
      requestAnimationFrame(checkProgress);
    });

    video.addEventListener("timeupdate", () => {
      if (playCount >= maxPlays && video.currentTime >= freezeTime) {
        freezeOnGreeting();
      }
    });

    video.addEventListener("ended", () => {
      if (playCount < maxPlays) {
        playCount++;
        video.currentTime = 0;
        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise.catch(() => {});
        }
      } else {
        freezeOnGreeting();
      }
    });

    // Asegurar reproducción inicial de entrada
    if (video.paused && !isFrozen) {
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {});
      }
    }
  }
</script>
