---
import nav from "../data/nav.json";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import BranchPicker from "./BranchPicker.astro";
import MobileMenu from "./MobileMenu.astro";
import sucursales from "../data/sucursales.json";
import { whatsappUrl } from "../utils/whatsapp";
import { resolveAnchor } from "../utils/links";

const { menu } = nav;

const consultaItem = menu.find((m) => m.label === "Consulta");
const ayudaItem = menu.find((m) => m.label === "Ayuda");

// Anclas según la página: #planes → /planes fuera del Home (ver utils/links.ts).
const getHref = (href: string) => resolveAnchor(href, Astro.url.pathname);

// Página activa: resalta el enlace del menú (naranja) y marca aria-current.
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href.startsWith("/") && href.replace(/\/$/, "") === currentPath;
const ayudaActive = Boolean(
  ayudaItem?.children?.some((sub) => isCurrent(sub.href)),
);
const esimActive = isCurrent("/esim");
const cambiateActive = isCurrent("/cambiate-a-megamovil");
const promosActive = isCurrent("/promociones");
---

<header
  class="w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs sticky top-0 z-40 transition-all duration-200"
>
  <div
    class="container mx-auto flex items-center justify-between gap-4 px-4 py-1 sm:px-6"
  >
    <!-- Logo Mega móvil -->
    <Logo variant="dark" />

    <!-- Navegación Principal Desktop (Estilo blanco original) -->
    <nav aria-label={nav.menuLabel} class="hidden lg:block">
      <ul class="flex items-center gap-1 xl:gap-2">
        <!-- 1. Menú desplegable Consulta -->
        <li class="group relative">
          <button
            type="button"
            class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 xl:px-3.5 py-1.5 text-[13.5px] font-bold xl:tracking-wide text-slate-700 hover:text-mega-orange hover:bg-orange-50/70 transition-all duration-150 cursor-pointer"
            aria-haspopup="true"
          >
            <span>Consulta</span>
            <Icon
              name="chevron-down"
              class="h-3.5 w-3.5 opacity-70 group-hover:rotate-180 transition-transform duration-200"
            />
          </button>

          <div
            class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 -translate-y-1 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0"
          >
            <ul
              class="w-60 rounded-2xl bg-white p-2 text-mega-navy shadow-xl border border-slate-100 space-y-0.5"
            >
              {
                consultaItem?.children?.map((sub) => (
                  <li>
                    <a
                      href={getHref(sub.href)}
                      target={
                        sub.target ||
                        (sub.href.startsWith("http") ? "_blank" : undefined)
                      }
                      rel={
                        sub.target === "_blank" || sub.href.startsWith("http")
                          ? "noopener noreferrer"
                          : undefined
                      }
                      aria-current={isCurrent(sub.href) ? "page" : undefined}
                      class:list={[
                        "block rounded-xl px-3.5 py-2 text-xs font-bold hover:bg-orange-50 hover:text-mega-orange transition-colors",
                        isCurrent(sub.href)
                          ? "bg-orange-50 text-mega-orange"
                          : "text-slate-700",
                      ]}
                    >
                      {sub.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>

        <!-- 2. Cámbiate a Mega móvil -->
        <li>
          <a
            href="/cambiate-a-megamovil"
            aria-current={cambiateActive ? "page" : undefined}
            class:list={[
              "inline-flex items-center whitespace-nowrap rounded-full px-2.5 xl:px-3.5 py-1.5 text-[13.5px] font-bold xl:tracking-wide hover:text-mega-orange hover:bg-orange-50/70 transition-all duration-150",
              cambiateActive
                ? "bg-orange-50 text-mega-orange"
                : "text-slate-700",
            ]}
          >
            Cámbiate a Mega móvil
          </a>
        </li>

        <!-- 3. Promociones -->
        <li>
          <a
            href="/promociones"
            aria-current={promosActive ? "page" : undefined}
            class:list={[
              "inline-flex items-center whitespace-nowrap rounded-full px-2.5 xl:px-3.5 py-1.5 text-[13.5px] font-bold xl:tracking-wide hover:text-mega-orange hover:bg-orange-50/70 transition-all duration-150",
              promosActive ? "bg-orange-50 text-mega-orange" : "text-slate-700",
            ]}
          >
            Promociones
          </a>
        </li>

        <!-- 4. eSIM -->
        <li>
          <a
            href="/esim"
            aria-current={esimActive ? "page" : undefined}
            class:list={[
              "inline-flex items-center whitespace-nowrap rounded-full px-2.5 xl:px-3.5 py-1.5 text-[13.5px] font-bold xl:tracking-wide hover:text-mega-orange hover:bg-orange-50/70 transition-all duration-150",
              esimActive ? "bg-orange-50 text-mega-orange" : "text-slate-700",
            ]}
          >
            eSIM
          </a>
        </li>

        <!-- 5. Menú desplegable Ayuda -->
        <li class="group relative">
          <button
            type="button"
            class:list={[
              "inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 xl:px-3.5 py-1.5 text-[13.5px] font-bold xl:tracking-wide hover:text-mega-orange hover:bg-orange-50/70 transition-all duration-150 cursor-pointer",
              ayudaActive ? "bg-orange-50 text-mega-orange" : "text-slate-700",
            ]}
            aria-haspopup="true"
          >
            <span>Ayuda</span>
            <Icon
              name="chevron-down"
              class="h-3.5 w-3.5 opacity-70 group-hover:rotate-180 transition-transform duration-200"
            />
          </button>

          <div
            class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 -translate-y-1 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0"
          >
            <ul
              class="w-56 rounded-2xl bg-white p-2 text-mega-navy shadow-xl border border-slate-100 space-y-0.5"
            >
              {
                ayudaItem?.children?.map((sub) => (
                  <li>
                    <a
                      href={getHref(sub.href)}
                      target={
                        sub.target ||
                        (sub.href.startsWith("http") ? "_blank" : undefined)
                      }
                      rel={
                        sub.target === "_blank" || sub.href.startsWith("http")
                          ? "noopener noreferrer"
                          : undefined
                      }
                      aria-current={isCurrent(sub.href) ? "page" : undefined}
                      class:list={[
                        "block rounded-xl px-3.5 py-2 text-xs font-bold hover:bg-orange-50 hover:text-mega-orange transition-colors",
                        isCurrent(sub.href)
                          ? "bg-orange-50 text-mega-orange"
                          : "text-slate-700",
                      ]}
                    >
                      {sub.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
      </ul>
    </nav>

    <!-- Acciones Derecha: Sucursal (abre el buscador BranchPicker) + CTA "Cámbiate" (modal del callcenter) + ☰ (menú celular) -->
    <div class="flex items-center gap-2.5">
      <!-- Sucursal: +500, así que abre un buscador (no una lista). En celular va dentro del menú. -->
      <button
        type="button"
        data-branch-open
        aria-haspopup="dialog"
        aria-label={`${sucursales.label}: cambiar`}
        class="hidden items-center gap-1.5 rounded-full border border-slate-200/90 bg-slate-100 py-1.5 pl-3 pr-2.5 font-display text-xs font-black uppercase text-mega-navy transition hover:bg-slate-200/60 cursor-pointer md:inline-flex"
      >
        <Icon name="map-pin" class="h-3.5 w-3.5 text-mega-orange" />
        <!-- En laptop chica (1024–1279 px) solo el ícono: el menú completo no deja espacio. La ciudad se ve al abrir el buscador. -->
        <span data-branch-current class="lg:hidden xl:inline">{sucursales.default}</span>
        <Icon name="chevron-down" class="h-3 w-3 text-slate-400" />
      </button>

      <!-- CTA principal: abre el modal "¡Llámame!" del callcenter (CallMeModal). Sin JavaScript queda WhatsApp. -->
      <a
        href={whatsappUrl(nav.headerCta.whatsappText)}
        data-callme
        data-callme-label=""
        data-callme-interest={nav.headerCta.interest}
        class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-mega-orange hover:bg-mega-orange-dark px-4 sm:px-5 py-2 font-display text-sm font-extrabold text-white shadow-orange-sm hover:shadow-orange-glow transition-all duration-150 hover:scale-105 active:scale-95"
      >
        <!-- Versión corta en celular chico y en laptop chica (1024–1279 px, donde el menú completo ocupa casi todo el ancho) -->
        <span class="sm:hidden lg:inline xl:hidden">{nav.headerCta.shortLabel}</span>
        <span class="hidden sm:inline lg:hidden xl:inline">{nav.headerCta.label}</span>
        <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>

      <!-- Menú celular/tablet: abre MobileMenu (pantalla completa) -->
      <button
        type="button"
        data-menu-open
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={nav.menuLabel}
        class="grid h-9 w-9 cursor-pointer place-items-center rounded-full bg-slate-100 text-mega-navy transition hover:bg-slate-200/80 lg:hidden"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>
</header>

<!-- Fuera del <header> (su backdrop-blur rompería el posicionamiento): menú de celular y buscador de sucursal -->
<MobileMenu />
<BranchPicker />
