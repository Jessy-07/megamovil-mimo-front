---
import nav from '../data/nav.json';
import site from '../data/site.json';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';

const { footer } = nav;
---

<footer class="mt-12 bg-[#051124] text-white relative overflow-hidden pb-24 sm:pb-12 border-t-4 border-mega-orange">
  <div class="container mx-auto px-4 pt-12 sm:px-6">
    <div class="grid gap-8 md:grid-cols-[1.3fr_1fr_1.3fr]">
      
      <!-- Columna 1: Logo, Soporte y CIS -->
      <div>
        <Logo variant="navy" />
        <div class="mt-5">
          <p class="text-xs font-black uppercase tracking-wider text-slate-400">
            {footer.supportLabel}
          </p>
          <a
            href={site.support.href}
            class="mt-1 inline-flex items-center gap-2 font-display text-2xl sm:text-3xl font-black text-white hover:text-mega-orange transition-colors"
          >
            <span class="grid h-8 w-8 place-items-center rounded-full bg-mega-orange text-white shadow-orange-sm">
              <Icon name="phone" class="h-4 w-4" />
            </span>
            <span>{site.support.phone}</span>
          </a>

          <div class="mt-3">
            <a
              id="cis"
              href={footer.cis.href}
              class="inline-flex items-center gap-2 text-sm font-extrabold text-slate-300 hover:text-mega-orange underline underline-offset-4 transition-colors"
            >
              <Icon name="map-pin" class="h-4 w-4 text-mega-orange" />
              <span>{footer.cis.label}</span>
            </a>
          </div>
        </div>

        <!-- Redes Sociales -->
        <ul class="mt-6 flex gap-2" aria-label={footer.socialsLabel}>
          {
            site.socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  aria-label={s.name}
                  class="grid h-10 w-10 place-items-center rounded-full bg-white/10 text-white transition-all hover:bg-mega-orange hover:scale-110"
                >
                  <SocialIcon slug={s.slug} class="h-5 w-5" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columnas de Enlaces -->
      {
        footer.columns.map((col) => (
          <nav aria-label={col.title}>
            <h3 class="font-display text-xs font-black uppercase tracking-wider text-mega-orange">
              {col.title}
            </h3>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-xs sm:text-sm font-bold text-slate-300 hover:text-white hover:underline transition-colors"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

    </div>

    <!-- Leyenda Legal Obligatoria -->
    <div class="mt-10 border-t border-white/10 pt-6 text-center sm:text-left">
      <p class="text-xs leading-relaxed text-slate-400">
        Aplican restricciones. Consulta términos y condiciones <a href="/terminos" class="font-bold underline text-white hover:text-mega-orange">aquí</a>. Vigencia a mes calendario. Todos los derechos reservados © {new Date().getFullYear()} Mega móvil, Megacable México.
      </p>
    </div>
  </div>
</footer>
