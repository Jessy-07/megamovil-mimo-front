---
/**
 * Franja delgada "Cámbiate sin perder tu número" (Home, debajo del banner principal).
 * Captura el teléfono ahí mismo (sin abrir modal) y lo manda al Click to Call de Convertia, igual que el modal.
 * - Formulario PROPIO con id distinto (#f-llamame-portabilidad) para que el callcenter distinga de dónde llegó el lead.
 *   El input lleva "telefono" en el id y data-ic-form-field="phone": así lo detecta Convertia al cargar la página.
 * - Validación, máscara, espera de Convertia y respaldo por WhatsApp: src/scripts/callForm.ts (compartido con el modal).
 * - "¿Prefieres escribir?": botón de WhatsApp APARTE (divisor "o" + texto "Escríbenos"), para no confundirlo con "¡Llámame!".
 * Textos en site.json → callStrip.
 */
import site from "../data/site.json";
import { whatsappUrl } from "../utils/whatsapp";

const { callStrip } = site;
const waHref = whatsappUrl(callStrip.whatsappText);
const whatsappPath =
  "M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z";
---

<!--
  Fondo azul oscuro de Mega móvil (mega-navy), sin sombra y más angosta que el banner: así no "choca" con la sombra del banner de arriba.
  El WhatsApp va SEPARADO del formulario por un divisor con "o" y con texto ("Escríbenos"), para que nadie escriba su número
  y toque WhatsApp creyendo que es el botón de enviar.
-->
<!-- Debajo del banner (sin encimarse). Ancho: max-w-6xl en pantallas grandes (≥1440); en laptop más corta (max-w-5xl) para que no
     se vea casi del ancho del banner. ≤1024 px: sin icono. Botones/campo a tamaño completo (h-12, 19 px) solo ≥1440; abajo, más chicos (h-11, 16 px). -->
<!-- pb: deja entre la franja y los planes el MISMO aire que entre los planes y compatibilidad (72 px celular / 136 px escritorio) -->
<section aria-labelledby="callstrip-title" class="px-4 pb-9 pt-6 sm:px-6 lg:px-8 lg:pb-20">
  <div class="relative mx-auto max-w-5xl overflow-hidden rounded-2xl min-[1440px]:max-w-6xl bg-mega-navy px-5 py-4 text-white sm:px-6 lg:py-3">
    <div class="pointer-events-none absolute -left-10 -top-16 h-40 w-40 rounded-full bg-mega-orange/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between lg:gap-6">
      <!-- Mensaje -->
      <div class="flex items-center gap-3.5">
        <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-full bg-white/10 min-[1025px]:grid text-white ring-1 ring-white/15" aria-hidden="true">
          <!-- Celular (smartphone): el número que se conserva -->
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="2" width="12" height="20" rx="2.5"></rect>
            <path d="M11 18h2"></path>
          </svg>
        </span>
        <div class="min-w-0">
          <h2 id="callstrip-title" class="font-display text-lg font-extrabold leading-tight text-white">{callStrip.title}</h2>
          <p class="text-sm font-medium text-slate-300">{callStrip.text}</p>
        </div>
      </div>

      <!-- Formulario  |  o  |  WhatsApp -->
      <div class="lg:shrink-0">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <form role="form" id="f-llamame-portabilidad" class="flex min-w-0 flex-col gap-2.5 sm:flex-1 sm:flex-row lg:flex-none" novalidate data-callstrip-form>
            <input type="hidden" name="interes" value={callStrip.interest} />
            <label for="telefono-portabilidad" class="sr-only">{callStrip.label}</label>
            <input
              type="tel"
              id="telefono-portabilidad"
              name="phone"
              data-ic-form-field="phone"
              class="telefono h-11 w-full min-w-0 sm:w-auto sm:flex-1 lg:w-52 lg:flex-none min-[1440px]:h-12 min-[1440px]:w-60 rounded-full border-2 border-white bg-white px-4 min-[1440px]:px-5 text-base font-bold tracking-wider text-mega-navy placeholder:font-medium placeholder:tracking-normal placeholder:text-slate-400 focus:border-mega-orange focus:outline-none"
              placeholder={callStrip.placeholder}
              inputmode="numeric"
              autocomplete="tel-national"
              maxlength="14"
              required
              aria-describedby="callstrip-error"
            />
            <button type="submit" id="f-llamame-portabilidad_0" class="btn-primary h-11 shrink-0 !px-5 !py-0 !text-base !shadow-none min-[1440px]:h-12 min-[1440px]:!px-6 min-[1440px]:!text-[19px]">{callStrip.button}</button>
          </form>

          <!-- Divisor "o": vertical en escritorio, horizontal en celular -->
          <div class="flex items-center gap-3 sm:mx-1 sm:h-11 sm:flex-col min-[1440px]:h-12 sm:gap-1" aria-hidden="true">
            <span class="h-px flex-1 bg-white/20 sm:h-auto sm:w-px"></span>
            <span class="text-xs font-bold uppercase text-slate-400">o</span>
            <span class="h-px flex-1 bg-white/20 sm:h-auto sm:w-px"></span>
          </div>

          <!-- ¿Prefieres escribir? Botón aparte y con texto: no se confunde con "¡Llámame!" -->
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={callStrip.whatsappLabel}
            class="inline-flex h-11 shrink-0 items-center min-[1440px]:h-12 justify-center gap-2 rounded-full border-2 border-white/25 px-5 font-display text-sm font-extrabold text-white hover:border-[#25D366] hover:bg-white/5"
          >
            <svg viewBox="0 0 448 512" fill="currentColor" class="h-5 w-5 text-[#25D366]" aria-hidden="true"><path d={whatsappPath} /></svg>
            {callStrip.whatsappButton}
          </a>
        </div>

        <p id="callstrip-error" class="mt-1.5 text-sm font-bold text-[#FFB4A8] empty:hidden" role="alert"></p>

        <!-- Si el callcenter no está disponible -->
        <p class="mt-2 text-sm font-semibold text-slate-300" data-callstrip-fallback hidden>
          {callStrip.fallbackText}
          <a href={waHref} target="_blank" rel="noopener noreferrer" class="font-black text-[#25D366] underline underline-offset-4" data-callstrip-fallback-link>
            {callStrip.fallbackLink}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { setupCallForm } from "../scripts/callForm";

  const form = document.querySelector<HTMLFormElement>("[data-callstrip-form]");
  const phone = document.getElementById("telefono-portabilidad") as HTMLInputElement | null;
  const button = document.getElementById("f-llamame-portabilidad_0") as HTMLButtonElement | null;
  const error = document.getElementById("callstrip-error");
  const fallback = document.querySelector<HTMLElement>("[data-callstrip-fallback]");
  const fallbackLink = document.querySelector<HTMLAnchorElement>("[data-callstrip-fallback-link]");

  if (form && phone) {
    setupCallForm(form, phone, button, {
      onFallback: (digits) => {
        if (fallbackLink) {
          const url = new URL(fallbackLink.href);
          url.searchParams.set("text", `${url.searchParams.get("text") ?? ""} Mi número es ${digits}.`.trim());
          fallbackLink.href = url.toString();
        }
        if (fallback) fallback.hidden = false;
      },
      onError: (message) => {
        if (error) error.textContent = message;
      },
    });
  }
</script>
