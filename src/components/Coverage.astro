---
import Icon from './Icon.astro';

const coverageData = {
  title: 'COBERTURA EN TODO MÉXICO',
  subtitle: 'Conexión de máxima estabilidad y velocidad 4.5G LTE donde quiera que estés.',
  cta: { label: 'Consulta cobertura', href: '/cobertura' },
  items: [
    {
      icon: 'globe',
      title: 'Cobertura Nacional',
      desc: 'En ciudades, carreteras y zonas rurales',
      badge: 'Red 4.5G',
    },
    {
      icon: 'flag',
      title: 'EE.UU. y Canadá',
      desc: 'Llama y navega sin costo adicional',
      badge: 'Sin roaming',
    },
    {
      icon: 'zap',
      title: 'Tecnología y Velocidad',
      desc: 'Banda 28 para máxima penetración en interiores',
      badge: 'LTE Max',
    },
  ],
  pins: [
    { col: 12, row: 8, city: 'Guadalajara' },
    { col: 14, row: 9, city: 'CDMX' },
    { col: 14, row: 5, city: 'Monterrey' },
    { col: 8, row: 4, city: 'Hermosillo' },
    { col: 20, row: 10, city: 'Cancún' },
    { col: 16, row: 11, city: 'Veracruz' },
  ],
};

const grid = [
  'XXX.XXXXXXXXXX....................',
  'XXX.XXXXXXXXXXXXXX................',
  '.XX.XXXXXXXXXXXXXXXXXX............',
  '.XX..XXXXXXXXXXXXXXXXXXXX.........',
  '..XX..XXXXXXXXXXXXXXXXXXXX........',
  '..XX...XXXXXXXXXXXXXXXXXXXX.......',
  '...XX...XXXXXXXXXXXXXXXXXX........',
  '...XX....XXXXXXXXXXXXXXXXXX.......',
  '....X.....XXXXXXXXXXXXXXXXXX......',
  '.........XXXXXXXXXXXXXXXXXXXX.....',
  '..........XXXXXXXXXXXXXXXXXXXXXX..',
  '...........XXXXXXXXXXXXXXXXXXXXXXX',
  '............XXXXX...XXXXXXXXXXXXXX',
  '.............XXX.....XXXXXXXXXXX..',
];
const cols = grid[0].length;
const rows = grid.length;
const dots = grid.flatMap((line, r) => [...line].flatMap((ch, c) => (ch === 'X' ? [{ c, r }] : [])));
---

<section id="cobertura" aria-labelledby="coverage-title" class="px-4 py-8 sm:px-6 md:py-10">
  <div class="container mx-auto overflow-hidden rounded-3xl bg-gradient-to-br from-[#061738] via-[#092454] to-mega-navy shadow-2xl p-6 sm:p-10 text-white relative border border-white/10">
    
    <div class="grid items-center gap-8 lg:grid-cols-12">
      
      <!-- Columna Izquierda: Información de Cobertura -->
      <div class="lg:col-span-7">
        <span class="inline-block rounded-full bg-mega-orange px-3.5 py-1 font-display text-xs font-black uppercase tracking-wider text-white shadow-orange-sm mb-2">
          Red Confiable
        </span>
        <h2 id="coverage-title" class="font-display text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-white">
          {coverageData.title}
        </h2>
        <p class="mt-2 font-sans text-sm sm:text-base font-semibold text-slate-200">
          {coverageData.subtitle}
        </p>

        <!-- 3 datos clave -->
        <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
          {
            coverageData.items.map((item) => (
              <div class="rounded-2xl bg-white/10 border border-white/10 p-4 backdrop-blur flex flex-col justify-between">
                <div>
                  <span class="inline-block rounded-md bg-mega-orange px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-white mb-2 shadow-xs">
                    {item.badge}
                  </span>
                  <h3 class="font-display text-sm font-black uppercase text-white leading-tight">
                    {item.title}
                  </h3>
                  <p class="mt-1 text-xs text-slate-300 font-medium leading-snug">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- CTA Consulta cobertura -->
        <div class="mt-6">
          <a href={coverageData.cta.href} class="btn-primary text-sm sm:text-base">
            <span>{coverageData.cta.label}</span>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Mapa de Puntos con Pines Naranjas -->
      <div class="lg:col-span-5 relative flex items-center justify-center p-2">
        <div class="relative w-full max-w-sm" aria-hidden="true">
          <svg viewBox={`0 0 ${cols * 10} ${rows * 10}`} class="w-full text-white/35" fill="currentColor">
            {dots.map(({ c, r }) => <circle cx={c * 10 + 5} cy={r * 10 + 5} r="2.8" />)}
          </svg>
          {
            coverageData.pins.map((pin) => (
              <div
                class="absolute -translate-x-1/2 -translate-y-1/2 group"
                style={`left:${((pin.col + 0.5) / cols) * 100}%;top:${((pin.row + 0.5) / rows) * 100}%`}
              >
                <span class="block h-3.5 w-3.5 rounded-full bg-mega-orange shadow-md ring-4 ring-mega-orange/40 animate-pulse" />
              </div>
            ))
          }
        </div>
      </div>

    </div>

  </div>
</section>
