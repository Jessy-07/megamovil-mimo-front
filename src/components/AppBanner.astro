---
import Mimo from './Mimo.astro';
---

<section id="app" aria-label="Descarga la App Mega móvil" class="px-4 py-8 sm:px-6 md:py-10">
  <div class="container mx-auto overflow-hidden rounded-3xl bg-gradient-to-r from-mega-orange via-[#FF6614] to-mega-orange-dark shadow-orange-glow border border-orange-400/30 relative">
    
    <div class="flex flex-col items-center justify-between gap-6 p-6 sm:p-10 lg:flex-row text-white relative z-10">
      
      <!-- Mimo -->
      <div class="shrink-0 flex items-center justify-center">
        <Mimo pose="phone" size="md" decorative class="mimo-wave" />
      </div>

      <!-- Texto Principal -->
      <div class="flex-1 text-center lg:text-left">
        <div class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3.5 py-1 text-xs font-black uppercase tracking-wider text-white shadow-xs mb-2 backdrop-blur">
          <span>📲 Tu línea en tus manos</span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight text-white drop-shadow-sm">
          Descarga la App Mega móvil
        </h2>
        <p class="mt-1 font-sans text-sm sm:text-base font-bold text-white/95 max-w-lg">
          Consulta tu saldo, recarga datos al instante y activa tu chip eSIM en minutos sin salir de casa.
        </p>

        <!-- Botones de descarga -->
        <div class="mt-5 flex flex-wrap items-center justify-center lg:justify-start gap-3">
          <a
            href="https://apps.apple.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-mega-navy hover:bg-black px-4 py-2.5 text-white shadow-md transition hover:scale-105 active:scale-95"
          >
            <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.58.67-1.08 1.74-.95 2.77 1 .08 2.05-.52 2.68-1.27z"/>
            </svg>
            <div class="text-left leading-tight">
              <span class="block text-[9px] uppercase font-bold tracking-wider opacity-80">Consíguela en</span>
              <span class="block font-display text-xs font-black uppercase">App Store</span>
            </div>
          </a>

          <a
            href="https://play.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-mega-navy hover:bg-black px-4 py-2.5 text-white shadow-md transition hover:scale-105 active:scale-95"
          >
            <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
              <path d="M3 20.5v-17c0-.83.67-1.5 1.5-1.5.3 0 .58.09.82.25l13.5 8.5c.67.42.88 1.3.46 1.97-.12.19-.28.34-.46.46l-13.5 8.5c-.24.16-.52.25-.82.25-.83 0-1.5-.67-1.5-1.43z"/>
            </svg>
            <div class="text-left leading-tight">
              <span class="block text-[9px] uppercase font-bold tracking-wider opacity-80">Disponible en</span>
              <span class="block font-display text-xs font-black uppercase">Google Play</span>
            </div>
          </a>
        </div>
      </div>

      <!-- QR Placeholder -->
      <div class="shrink-0 flex flex-col items-center justify-center rounded-2xl bg-white p-4 text-mega-navy shadow-xl border border-white">
        <div class="grid h-24 w-24 place-items-center rounded-lg bg-slate-900 p-2 text-white">
          <svg viewBox="0 0 24 24" class="h-full w-full fill-current" aria-hidden="true">
            <path d="M2 2h8v8H2V2zm2 2v4h4V4H4zm10-2h8v8h-8V2zm2 2v4h4V4h-4zM2 14h8v8H2v-8zm2 2v4h4v-4H4zm14 2h2v4h-2v-4zm-4-2h2v2h-2v-2zm2 2h2v2h-2v-2zm2-2h2v2h-2v-2zm0 4h2v2h-2v-2zm-4 0h2v2h-2v-2zm4-8h2v2h-2v-2zm-2 2h2v2h-2v-2zm-2-2h2v2h-2v-2z"/>
          </svg>
        </div>
        <span class="mt-2 text-[10px] font-black uppercase tracking-wider text-slate-700">
          Escanea el código
        </span>
      </div>

    </div>

  </div>
</section>
