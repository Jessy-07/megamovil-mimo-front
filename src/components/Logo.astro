---
import { Image } from 'astro:assets';
import logoImg from '../assets/img/general/megamovil-logo.png';
import site from '../data/site.json';

interface Props {
  class?: string;
  variant?: 'light' | 'dark' | 'navy';
}
const { class: className = '' } = Astro.props;
---

<a href="/" class:list={['inline-flex items-center transition-transform hover:scale-[1.02] active:scale-95 shrink-0', className]} aria-label={`${site.name} – inicio`}>
  <Image
    src={logoImg}
    alt="Mega móvil – La Telefonía Celular de MEGA"
    width={260}
    height={82}
    class="h-12 sm:h-14 lg:h-[58px] w-auto object-contain"
    loading="eager"
    fetchpriority="high"
  />
</a>
