---

{
  icon && (
    <span class:list={["inline-grid shrink-0 place-items-center rounded-full text-white", className]} style={`background:${icon.bg}`} title={icon.name}>
      <svg viewBox={icon.viewBox} class="h-[52%] w-[52%]" fill="currentColor" role="img" aria-label={icon.name}>
        {/* Snapchat: ghost blanco con contorno negro, como su logo oficial (sobre amarillo, sin contorno no se ve) */}
        <path d={icon.path} stroke={icon.stroke} stroke-width={icon.stroke ? 22 : undefined} stroke-linejoin="round" paint-order="stroke" />
      </svg>
    </span>
  )
}
