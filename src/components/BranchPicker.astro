---
import { safeJson } from "../utils/safeJson";
/**
 * Selector de SUCURSAL (ciudad/zona con servicio; las promociones cambian por sucursal). Son +500: NUNCA se muestra la lista
 * completa de entrada. Patrón "buscar en vez de recorrer":
 * - Sin escribir: sucursal actual, recientes, más buscadas y "Ver todas por estado" (estado como encabezado fijo).
 * - Al escribir: filtra por sucursal, municipio que cubre o código postal; ignora acentos y mayúsculas.
 * - Sin resultados: sugiere el C.P. y ofrece WhatsApp.
 * Un solo <dialog> para todo el sitio. Escritorio (md+): panel de 380 px pegado al botón que lo abrió. Celular: hoja que sube
 * desde abajo, casi a pantalla completa. Se abre con cualquier elemento [data-branch-open]; los textos [data-branch-current]
 * muestran la sucursal elegida.
 * La elección se guarda en el navegador (localStorage "mm-ciudad", recientes en "mm-ciudad-recientes") y avisa con el
 * evento "mm:ciudad" en window (para que las secciones muestren las promos de esa sucursal).
 * [PENDIENTE] Geolocalización: detectar la sucursal al entrar (por ahora queda la de "default").
 * Datos en sucursales.json (de prueba).
 */
import data from "../data/sucursales.json";
import site from "../data/site.json";
import Icon from "./Icon.astro";

const payload = {
  default: data.default,
  popular: data.popular,
  estados: data.estados,
  whatsapp: site.whatsapp.href,
};
---

<dialog
  id="branch-picker"
  aria-labelledby="branch-picker-title"
  class="m-0 mt-auto w-full max-w-none overflow-hidden rounded-t-3xl bg-white p-0 text-mega-navy shadow-2xl backdrop:bg-mega-navy/50 md:w-[380px] md:rounded-2xl md:border md:border-slate-200 md:backdrop:bg-transparent"
>
  <!-- Celular: alto fijo (no "brinca" mientras se escribe). Escritorio: se ajusta al contenido, máx. 520 px. -->
  <div class="flex h-[85dvh] flex-col md:h-auto md:max-h-[520px]">
    <!-- Encabezado -->
    <div class="relative px-5 pb-3 pt-3 md:pt-4">
      <span class="mx-auto mb-3 block h-1 w-10 rounded-full bg-slate-200 md:hidden" aria-hidden="true"></span>
      <h2 id="branch-picker-title" class="font-display text-lg font-extrabold leading-tight">{data.title}</h2>
      <p class="mt-0.5 text-sm font-medium text-slate-500">{data.subtitle}</p>
      <button
        type="button"
        data-branch-close
        aria-label="Cerrar"
        class="absolute right-3 top-3 grid h-9 w-9 place-items-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-mega-navy cursor-pointer md:top-3"
      >
        <Icon name="close" class="h-4 w-4" />
      </button>

      <!-- Buscador -->
      <label for="branch-search" class="sr-only">{data.searchPlaceholder}</label>
      <div class="relative mt-3">
        <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input
          id="branch-search"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder={data.searchPlaceholder}
          aria-controls="branch-results"
          class="h-12 w-full rounded-full border-2 border-slate-200 bg-white pl-11 pr-4 text-base font-semibold text-mega-navy placeholder:font-medium placeholder:text-slate-400 focus:border-mega-orange focus:outline-none"
        />
      </div>
    </div>

    <!-- Resultados (los dibuja el script) -->
    <div id="branch-results" class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-2 pb-[calc(0.75rem+env(safe-area-inset-bottom))] md:pb-3" aria-live="polite"></div>
  </div>
</dialog>

<!-- Aviso breve al elegir sucursal -->
<p id="branch-toast" role="status" hidden class="fixed inset-x-0 top-24 z-[60] mx-auto w-max max-w-[calc(100%-2rem)] rounded-full bg-mega-navy px-5 py-2.5 text-center text-sm font-semibold text-white shadow-xl"></p>

<script is:inline type="application/json" id="branch-data" set:html={safeJson(payload)}></script>

<script>
  type Sucursal = { nombre: string; municipios?: string[]; cp?: string[] };
  type Estado = { estado: string; sucursales: Sucursal[] };
  type Item = Sucursal & { estado: string; key: string; keysMun: string[] };

  const dialog = document.getElementById("branch-picker") as HTMLDialogElement | null;
  const input = document.getElementById("branch-search") as HTMLInputElement | null;
  const results = document.getElementById("branch-results");
  const toast = document.getElementById("branch-toast");
  const raw = document.getElementById("branch-data")?.textContent;

  if (dialog && input && results && raw) {
    const data = JSON.parse(raw) as { default: string; popular: string[]; estados: Estado[]; whatsapp: string };
    const KEY = "mm-ciudad";
    const RECENT = "mm-ciudad-recientes";

    const norm = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

    const items: Item[] = data.estados.flatMap((e) =>
      e.sucursales.map((s) => ({ ...s, estado: e.estado, key: norm(s.nombre), keysMun: (s.municipios ?? []).map(norm) })),
    );
    const byName = new Map(items.map((i) => [i.nombre, i]));

    const read = (k: string) => {
      try {
        return localStorage.getItem(k);
      } catch {
        return null;
      }
    };
    const write = (k: string, v: string) => {
      try {
        localStorage.setItem(k, v);
      } catch {
        /* sin almacenamiento: solo en esta visita */
      }
    };

    let current = byName.has(read(KEY) ?? "") ? read(KEY)! : data.default;
    let recents: string[] = (() => {
      try {
        return (JSON.parse(read(RECENT) ?? "[]") as string[]).filter((n) => byName.has(n));
      } catch {
        return [];
      }
    })();
    let showAll = false;

    const paintCurrent = () =>
      document.querySelectorAll<HTMLElement>("[data-branch-current]").forEach((el) => (el.textContent = current));
    paintCurrent();

    // ── Dibujo ─────────────────────────────────────────────────────────────────────────
    const pin =
      '<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>';
    const check =
      '<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

    const row = (i: Item, note = "") => {
      const on = i.nombre === current;
      return `<li><button type="button" data-branch-pick="${esc(i.nombre)}" aria-current="${on}" class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left hover:bg-slate-50 focus-visible:bg-slate-50 focus-visible:outline-none ${on ? "bg-orange-50 text-mega-orange-dark" : ""}">
        <span class="${on ? "text-mega-orange" : "text-slate-300"}">${pin}</span>
        <span class="min-w-0 flex-1 leading-tight"><span class="block text-[15px] font-bold">${esc(i.nombre)}</span><span class="block truncate text-xs font-medium text-slate-500">${esc(i.estado)}${note ? " · " + esc(note) : ""}</span></span>
        ${on ? `<span class="text-mega-orange">${check}</span>` : ""}
      </button></li>`;
    };
    const section = (title: string, rows: string, sticky = false) =>
      `<p class="${sticky ? "sticky top-0 z-10 bg-white " : ""}px-3 pb-1 pt-3 text-[11px] font-black uppercase tracking-wider text-slate-400">${esc(title)}</p><ul>${rows}</ul>`;

    const renderHome = () => {
      const cur = byName.get(current);
      const rec = recents.filter((n) => n !== current).map((n) => byName.get(n)!).slice(0, 3);
      const pop = data.popular.filter((n) => n !== current && !rec.some((r) => r.nombre === n)).map((n) => byName.get(n)).filter(Boolean) as Item[];
      let html = "";
      if (cur) html += section("Tu sucursal", row(cur));
      if (rec.length) html += section("Recientes", rec.map((i) => row(i)).join(""));
      if (pop.length) html += section("Más buscadas", pop.map((i) => row(i)).join(""));
      if (showAll) {
        html += data.estados.map((e) => section(e.estado, e.sucursales.map((s) => row(byName.get(s.nombre)!)).join(""), true)).join("");
      } else {
        html += `<button type="button" data-branch-all class="mx-3 mt-3 mb-1 inline-flex items-center gap-1.5 font-display text-sm font-bold text-mega-orange-dark hover:underline underline-offset-4 cursor-pointer">Ver todas por estado (${items.length})<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>`;
      }
      results.innerHTML = html;
    };

    const search = (q: string) => {
      const nq = norm(q);
      const digits = nq.replace(/\D/g, "");
      const scored: { i: Item; s: number; note: string }[] = [];
      for (const i of items) {
        if (i.key.startsWith(nq)) scored.push({ i, s: 0, note: "" });
        else if (i.key.includes(nq)) scored.push({ i, s: 1, note: "" });
        else {
          const m = i.keysMun.findIndex((k) => k.includes(nq));
          if (m >= 0) scored.push({ i, s: 2, note: `incluye ${i.municipios![m]}` });
          else if (norm(i.estado).startsWith(nq)) scored.push({ i, s: 3, note: "" });
          else if (digits.length >= 2 && digits === nq) {
            const p = (i.cp ?? []).filter((c) => digits.startsWith(c) || c.startsWith(digits)).sort((a, b) => b.length - a.length)[0];
            if (p) scored.push({ i, s: 4 - Math.min(p.length, 4) / 10, note: `C.P. ${digits}` });
          }
        }
      }
      scored.sort((a, b) => a.s - b.s || a.i.nombre.localeCompare(b.i.nombre, "es"));
      const top = scored.slice(0, 40);
      results.innerHTML = top.length
        ? section(`${top.length} resultado${top.length === 1 ? "" : "s"}`, top.map((r) => row(r.i, r.note)).join(""))
        : `<div class="px-4 py-8 text-center"><p class="font-display font-bold">No encontramos «${esc(q)}»</p><p class="mt-1 text-sm text-slate-500">Prueba con tu código postal o escríbenos y te ayudamos.</p><a href="${esc(data.whatsapp)}" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex h-11 items-center justify-center gap-2 rounded-full border-2 border-slate-200 px-5 font-display text-sm font-extrabold hover:border-[#25D366]">Escríbenos por WhatsApp</a></div>`;
    };

    const render = () => (input.value.trim() ? search(input.value) : renderHome());

    // ── Abrir / cerrar ─────────────────────────────────────────────────────────────────
    const desktop = window.matchMedia("(min-width: 768px)");
    const place = (trigger: HTMLElement | null) => {
      const s = dialog.style;
      if (desktop.matches && trigger) {
        const r = trigger.getBoundingClientRect();
        s.top = `${r.bottom + 8}px`;
        s.left = `${Math.max(12, Math.min(r.right - 380, window.innerWidth - 392))}px`;
        s.right = "auto";
        s.bottom = "auto";
      } else {
        s.top = s.left = s.right = s.bottom = "";
      }
    };

    let opener: HTMLElement | null = null;
    const open = (trigger: HTMLElement | null) => {
      opener = trigger;
      input.value = "";
      showAll = false;
      renderHome();
      place(trigger);
      dialog.showModal();
      input.focus();
    };
    const close = () => dialog.close();

    document.addEventListener("click", (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>("[data-branch-open]");
      if (t) {
        e.preventDefault();
        open(t);
      }
    });
    dialog.querySelector("[data-branch-close]")?.addEventListener("click", close);
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close(); // clic fuera del panel
    });
    dialog.addEventListener("close", () => opener?.focus());
    window.addEventListener("resize", () => dialog.open && place(opener));

    let t: number | undefined;
    input.addEventListener("input", () => {
      clearTimeout(t);
      t = window.setTimeout(render, 80);
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        results.querySelector<HTMLButtonElement>("[data-branch-pick]")?.click();
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        results.querySelector<HTMLButtonElement>("[data-branch-pick]")?.focus();
      }
    });
    results.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
      const btns = [...results.querySelectorAll<HTMLButtonElement>("[data-branch-pick]")];
      const i = btns.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      e.preventDefault();
      if (e.key === "ArrowUp" && i === 0) input.focus();
      else btns[Math.min(btns.length - 1, Math.max(0, i + (e.key === "ArrowDown" ? 1 : -1)))].focus();
    });

    // ── Elegir ─────────────────────────────────────────────────────────────────────────
    let toastTimer: number | undefined;
    results.addEventListener("click", (e) => {
      const all = (e.target as HTMLElement).closest("[data-branch-all]");
      if (all) {
        showAll = true;
        renderHome();
        return;
      }
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-branch-pick]");
      if (!btn) return;
      current = btn.dataset.branchPick!;
      recents = [current, ...recents.filter((n) => n !== current)].slice(0, 4);
      write(KEY, current);
      write(RECENT, JSON.stringify(recents));
      paintCurrent();
      window.dispatchEvent(new CustomEvent("mm:ciudad", { detail: current }));
      close();
      if (toast) {
        toast.textContent = `Mostrando promociones de ${current}`;
        toast.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => (toast.hidden = true), 2600);
      }
    });
  }
</script>
