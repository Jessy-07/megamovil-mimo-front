---
/**
 * Banner principal del Home (arte del equipo de diseño).
 *
 * Archivos: src/assets/img/home/ (Astro los optimiza: genera WebP y tamaños al compilar).
 *  · Escritorio y tablet (≥ 640 px): 1920×550 → banner-principal-pc.jpg
 *  · Celular (< 640 px): 1080×1350 (4:5) → banner-principal-mob.jpg
 * Para cambiar el banner basta con reemplazar esos dos archivos (mismo nombre y medida).
 *
 * Hoy hay un solo banner. Si se agregan más a `slides`, aparecen las flechas, los puntos y la rotación.
 */
import { getImage } from "astro:assets";
import bannerPc from "../assets/img/home/banner-principal-pc.jpg";
import bannerMob from "../assets/img/home/banner-principal-mob.jpg";

const slides = [
  {
    id: "7gb-100",
    desktop: bannerPc,
    mobile: bannerMob,
    alt: "Mi MOvil con Mega móvil: 7 GB por $100. Más beneficios conservando tu número: WhatsApp ilimitado, redes sociales ilimitadas (Facebook, X, Instagram y Messenger), minutos y SMS incluidos. Contrata ahora.",
    href: "#planes",
    external: false,
  },
];

const isCarousel = slides.length > 1;

// Versiones optimizadas (WebP + JPG de respaldo) para cada banner.
const srcset = async (img: ImageMetadata, widths: number[], format: "webp" | "jpg") => {
  const out = await Promise.all(widths.filter((w) => w <= img.width).map(async (w) => {
    const r = await getImage({ src: img, width: w, format, quality: 82 });
    return `${r.src} ${w}w`;
  }));
  return out.join(", ");
};
const rendered = await Promise.all(slides.map(async (s) => ({
  ...s,
  desktopWebp: await srcset(s.desktop, [960, 1488, 1920], "webp"),
  desktopJpg: await srcset(s.desktop, [960, 1488, 1920], "jpg"),
  mobileWebp: await srcset(s.mobile, [540, 720, 1080], "webp"),
  mobileJpg: await srcset(s.mobile, [540, 720, 1080], "jpg"),
  fallback: (await getImage({ src: s.desktop, width: 1920, format: "jpg", quality: 82 })).src,
})));

// El contenedor toma la proporción exacta del arte: nunca se recorta (ni el texto legal de abajo).
const desktopRatio = `${bannerPc.width} / ${bannerPc.height}`;
const mobileRatio = `${bannerMob.width} / ${bannerMob.height}`;
---

<!-- Mismo contenedor que el Header (container + px-4 sm:px-6): el banner queda alineado con el logo y el botón "Cámbiate". -->
<section id="promos" aria-label="Promociones exclusivas Mega móvil" class="container mx-auto px-4 pt-3 sm:px-6">
  <div
    class="w-full overflow-hidden rounded-hero shadow-[0_12px_30px_-14px_rgba(6,22,48,0.28)] relative bg-black/5 [aspect-ratio:var(--hero-ratio-mob)] sm:[aspect-ratio:var(--hero-ratio)]"
    style={`--hero-ratio: ${desktopRatio}; --hero-ratio-mob: ${mobileRatio}`}
  >
    <div
      class="relative w-full h-full"
      role={isCarousel ? "region" : undefined}
      aria-roledescription={isCarousel ? "carrusel" : undefined}
      aria-label={isCarousel ? "Banners promocionales Mega móvil" : undefined}
    >
      <div id="promo-track" class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto scroll-smooth w-full h-full items-stretch" aria-live="off">
        {
          rendered.map((slide, i) => (
            <div
              data-slide
              role={isCarousel ? "group" : undefined}
              aria-roledescription={isCarousel ? "slide" : undefined}
              aria-label={isCarousel ? `${i + 1} / ${slides.length}` : undefined}
              class="relative w-full h-full shrink-0 snap-center overflow-hidden"
            >
              <a
                href={slide.href}
                target={slide.external ? "_blank" : undefined}
                rel={slide.external ? "noopener noreferrer" : undefined}
                class="block w-full h-full focus:outline-none"
              >
                <picture class="block w-full h-full">
                  <source media="(max-width: 639px)" type="image/webp" srcset={slide.mobileWebp} sizes="100vw" />
                  <source media="(max-width: 639px)" type="image/jpeg" srcset={slide.mobileJpg} sizes="100vw" />
                  <source media="(min-width: 640px)" type="image/webp" srcset={slide.desktopWebp} sizes="(min-width: 1536px) 1488px, 100vw" />
                  <source media="(min-width: 640px)" type="image/jpeg" srcset={slide.desktopJpg} sizes="(min-width: 1536px) 1488px, 100vw" />
                  <img
                    src={slide.fallback}
                    alt={slide.alt}
                    width={slide.desktop.width}
                    height={slide.desktop.height}
                    loading={i === 0 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : "auto"}
                    decoding="async"
                    class="block w-full h-full object-cover object-center select-none"
                  />
                </picture>
              </a>
            </div>
          ))
        }
      </div>

      {isCarousel && (
        <div class="absolute bottom-2 right-2 sm:bottom-4 sm:right-6 z-20 flex items-center gap-1.5 sm:gap-2 bg-black/50 backdrop-blur-md px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full border border-white/20 shadow-lg scale-90 sm:scale-100 origin-bottom-right">
          <button type="button" data-promo-prev aria-label="Banner anterior" class="grid h-7 w-7 place-items-center rounded-full text-white/90 hover:text-white hover:bg-white/20 transition cursor-pointer">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <div class="flex items-center gap-1.5 px-1">
            {slides.map((_, i) => (
              <button
                type="button"
                data-promo-dot={i}
                aria-label={`Ir al banner ${i + 1}`}
                class:list={["h-2.5 rounded-full transition-all duration-200 cursor-pointer", i === 0 ? "w-7 bg-mega-orange shadow-sm" : "w-2.5 bg-white/50 hover:bg-white/80"]}
              />
            ))}
          </div>
          <button type="button" data-promo-next aria-label="Siguiente banner" class="grid h-7 w-7 place-items-center rounded-full text-white/90 hover:text-white hover:bg-white/20 transition cursor-pointer">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6" /></svg>
          </button>
          <button type="button" data-promo-toggle aria-label="Pausar rotación" class="grid h-7 w-7 place-items-center rounded-full text-white/90 hover:text-white hover:bg-white/20 transition cursor-pointer ml-1">
            <svg data-icon-pause class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" /><rect x="14" y="4" width="4" height="16" /></svg>
            <svg data-icon-play class="h-3.5 w-3.5 hidden" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3" /></svg>
          </button>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  // Rotación: solo corre si hay más de un banner (si no, no existen los puntos).
  const track = document.getElementById("promo-track") as HTMLDivElement | null;
  const dots = document.querySelectorAll<HTMLButtonElement>("[data-promo-dot]");
  const prevBtn = document.querySelector("[data-promo-prev]");
  const nextBtn = document.querySelector("[data-promo-next]");
  const toggleBtn = document.querySelector("[data-promo-toggle]");
  const iconPause = document.querySelector("[data-icon-pause]");
  const iconPlay = document.querySelector("[data-icon-play]");

  if (track && dots.length > 1) {
    let currentIndex = 0;
    const count = dots.length;
    let isPaused = false;
    let isHovered = false;

    const updateUI = (idx: number) => {
      currentIndex = idx;
      dots.forEach((dot, i) => {
        dot.className =
          i === idx
            ? "h-2.5 rounded-full transition-all duration-200 cursor-pointer w-7 bg-mega-orange shadow-sm"
            : "h-2.5 rounded-full transition-all duration-200 cursor-pointer w-2.5 bg-white/50 hover:bg-white/80";
      });
    };
    const goTo = (idx: number) => {
      const target = (idx + count) % count;
      track.scrollTo({ left: target * track.clientWidth, behavior: "smooth" });
      updateUI(target);
    };

    track.addEventListener("scroll", () => {
      const newIdx = Math.round(track.scrollLeft / track.clientWidth);
      if (newIdx !== currentIndex) updateUI(newIdx);
    });
    prevBtn?.addEventListener("click", () => goTo(currentIndex - 1));
    nextBtn?.addEventListener("click", () => goTo(currentIndex + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
    track.addEventListener("mouseenter", () => (isHovered = true));
    track.addEventListener("mouseleave", () => (isHovered = false));
    toggleBtn?.addEventListener("click", () => {
      isPaused = !isPaused;
      iconPause?.classList.toggle("hidden", isPaused);
      iconPlay?.classList.toggle("hidden", !isPaused);
    });
    window.setInterval(() => {
      if (!isPaused && !isHovered) goTo(currentIndex + 1);
    }, 6000);
  }
</script>
