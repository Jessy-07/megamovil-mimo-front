---
/**
 * Promociones. Misma URL que el sitio anterior (/promociones).
 * Cada promoción es el ARTE CUADRADO del equipo de diseño (como en el sitio actual), en una tarjeta con su título corto,
 * vigencia y los mismos botones que las tarjetas de planes del Home: "¡La quiero!" (callcenter) + WhatsApp.
 * - El texto del arte va completo en el alt (Google y lectores de pantalla) y el título corto queda como texto visible.
 * - Datos en promociones.json (listo para el admin; ahí está la medida del arte).
 * Vigencia: se filtra al generar el sitio (active, startsAt, endsAt) y TAMBIÉN en el navegador (data-ends), por si el sitio
 * no se vuelve a generar el día que vence. Sin promociones vigentes → aviso + "Avísame por WhatsApp" y los planes siguen vendiendo.
 */
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import PageHero from "../components/PageHero.astro";
import Plans from "../components/Plans.astro";
import Icon from "../components/Icon.astro";
import { BellRing, CalendarClock } from "lucide-react";
import SocialIcon from "../components/SocialIcon.astro";
import data from "../data/promociones.json";
import { planSummary, whatsappUrl } from "../utils/whatsapp";
// REFERENCIA: reemplazar por Mimo sosteniendo una etiqueta de "oferta" / con confeti. PNG transparente, ~500×500.
import mimoPromo from "../assets/img/general/mimo-promo.png";

const origin = Astro.site ? Astro.site.href : "https://megamovil.megacable.com.mx";
const pageUrl = new URL("/promociones", origin).href;

type Promo = (typeof data.promos)[number] & { startsAt: string | null; endsAt: string | null };

// Vigentes hoy (fecha de generación del sitio). El navegador vuelve a revisar endsAt.
const today = new Date().toISOString().slice(0, 10);
const promos = (data.promos as Promo[]).filter((p) => p.active && (!p.startsAt || p.startsAt <= today) && (!p.endsAt || p.endsAt >= today));

const dateLabel = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric" });

// 1 promo: centrada y angosta · 2: dos columnas (máx. 896 px, así el botón queda en la primera pantalla) · 3 o más: tres columnas.
const gridClass =
  promos.length === 1 ? "mx-auto max-w-md grid-cols-1" : promos.length === 2 ? "mx-auto max-w-4xl grid-cols-1 md:grid-cols-2" : "grid-cols-1 md:grid-cols-2 lg:grid-cols-3";

const planWhatsapp = (plan: Parameters<typeof planSummary>[0]) => whatsappUrl(data.plans.whatsappText.replace("{plan}", planSummary(plan)));

const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: data.seo.title, description: data.seo.description, url: pageUrl, inLanguage: "es-MX" },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: origin },
      { "@type": "ListItem", position: 2, name: "Promociones", item: pageUrl },
    ],
  },
  ...(promos.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "ItemList",
          name: "Promociones Mega móvil",
          itemListElement: promos.map((p, i) => ({
            "@type": "ListItem",
            position: i + 1,
            item: {
              "@type": "Offer",
              name: p.title,
              image: new URL(p.image.src, origin).href,
              price: p.price,
              priceCurrency: "MXN",
              url: pageUrl,
              ...(p.endsAt ? { priceValidUntil: p.endsAt } : {}),
            },
          })),
        },
      ]
    : []),
];
---

<Layout title={data.seo.title} description={data.seo.description} {jsonLd}>
  <!-- ENCABEZADO UNIFICADO STICKY -->
  <div id="sticky-header-container" class="sticky top-0 z-50 w-full">
    <TopBar />
    <Header />
  </div>

  <main id="contenido" class="bg-slate-50/60 pb-16">
    <!-- 1. HERO -->
    <PageHero
      id="promos-title"
      crumb="Promociones"
      titleBefore={data.hero.titleBefore}
      titleHighlight={data.hero.titleHighlight}
      titleAfter={data.hero.titleAfter}
      image={mimoPromo}
      imageAlt="Mimo, la mascota de Mega móvil, con las promociones"
    />

    <!-- 2. PROMOCIONES (caja sobrepuesta al hero, como las demás páginas internas; tarjetas con borde, sin sombra) -->
    <div class="relative z-10 mx-auto -mt-12 container px-7 sm:px-10 lg:px-12">
      <section aria-label="Promociones vigentes" class="mx-auto max-w-6xl rounded-3xl bg-white p-4 sm:p-8 lg:p-10 shadow-card-clean">
        {
          promos.length > 0 && (
            <ul class:list={["grid gap-5 sm:gap-6", gridClass]} data-promo-list>
              {promos.map((p) => {
                const href = whatsappUrl(p.whatsappText);
                const askHref = whatsappUrl(`Hola, tengo dudas sobre la promoción ${p.title}.`);
                // "¡La quiero!" abre el modal "¡Llámame!" del callcenter (CallMeModal); el href de WhatsApp queda de respaldo sin JS.
                const callme = { "data-callme": "", "data-callme-label": `Promoción ${p.title}`, "data-callme-interest": `Promoción ${p.title} - ${p.id}` };
                return (
                  <li id={p.id} class="scroll-mt-36" data-promo data-ends={p.endsAt ?? undefined}>
                    <article class="flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white">
                      {/* El arte también abre el modal (es lo primero que la gente toca). Fuera del orden de tabulación: el botón ya es el enlace. */}
                      <a href={href} target="_blank" rel="noopener noreferrer" tabindex="-1" class="block bg-slate-100" {...callme}>
                        <img src={p.image.src} alt={p.image.alt} width="800" height="800" loading="eager" decoding="async" class="aspect-square w-full object-cover" />
                      </a>
                      <div class="flex flex-1 flex-col p-5 sm:p-6">
                        <p class="text-xs font-black uppercase tracking-widest text-mega-orange">{p.text}</p>
                        <h2 class="mt-1 font-display text-xl sm:text-2xl font-extrabold leading-tight tracking-tight text-mega-navy">{p.title}</h2>
                        {p.endsAt && (
                          <p class="mt-2 inline-flex items-center gap-1.5 text-sm font-bold text-slate-600">
                            <CalendarClock className="h-4 w-4 text-mega-orange" aria-hidden="true" />
                            Válida hasta el {dateLabel(p.endsAt)}
                          </p>
                        )}
                        {/* Mismos botones que las tarjetas de planes del Home */}
                        <div class="mt-auto flex items-center gap-2.5 pt-5">
                          <a
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                            {...callme}
                            class="inline-flex h-12 flex-1 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-mega-orange px-5 font-display text-[19px] font-extrabold text-white hover:bg-mega-orange-dark"
                          >
                            {data.ctaLabel}
                          </a>
                          <a
                            href={askHref}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Preguntar por la promoción ${p.title} por WhatsApp`}
                            title="¿Dudas? Pregúntanos por WhatsApp"
                            class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-[#25D366]/10 text-[#1DA851] ring-1 ring-[#25D366]/25 hover:bg-[#25D366]/15"
                          >
                            <SocialIcon slug="whatsapp" class="h-5 w-5" />
                          </a>
                        </div>
                        <p class="mt-3 text-xs font-medium text-slate-500">{p.legal}</p>
                      </div>
                    </article>
                  </li>
                );
              })}
            </ul>
          )
        }

        {
          promos.length > 0 && (
            <p class="mt-6 text-center text-sm font-semibold text-slate-500" data-promo-howto>
              ¿Todavía no te cambias?
              <a href={data.howTo.href} class="ml-1 inline-flex items-center gap-1 font-black text-mega-orange hover:underline underline-offset-4">
                {data.howTo.label}
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </p>
          )
        }

        <!-- Sin promociones vigentes (también se muestra si el navegador detecta que todas vencieron) -->
        <div data-promo-empty hidden={promos.length > 0}>
        <div class="flex flex-col items-center gap-4 py-4 text-center sm:py-6">
          <span class="grid h-16 w-16 place-items-center rounded-2xl bg-orange-50 text-mega-orange">
            <BellRing className="h-8 w-8" aria-hidden="true" />
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-black uppercase tracking-tight text-mega-navy">{data.empty.title}</h2>
          <p class="max-w-xl text-sm sm:text-base font-medium text-slate-600">{data.empty.text}</p>
          <a
            href={whatsappUrl(data.empty.whatsappText)}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-6 py-3.5 font-display text-sm font-black text-white hover:bg-[#20ba5a]"
          >
            <BellRing className="h-4 w-4" aria-hidden="true" />
            {data.empty.label}
          </a>
        </div>
        </div>
      </section>
    </div>

    <!-- 3. PLANES: siempre (con o sin promociones). Botón con WhatsApp prellenado -->
    <Plans title={data.plans.title} ctaHrefFor={planWhatsapp} />
  </main>

  <!-- FOOTER -->
  <Footer />

  <!-- BOTONES FLOTANTES -->
  <FloatingActions />
</Layout>

<script>
  // Si una promoción venció después de generar el sitio, se oculta; si ya no queda ninguna, aparece el aviso.
  const today = new Date().toISOString().slice(0, 10);
  const cards = [...document.querySelectorAll<HTMLElement>("[data-promo]")];
  cards.forEach((c) => {
    if (c.dataset.ends && c.dataset.ends < today) c.style.display = "none";
  });
  if (cards.length && cards.every((c) => c.style.display === "none")) {
    document.querySelectorAll<HTMLElement>("[data-promo-list], [data-promo-howto]").forEach((el) => (el.style.display = "none"));
    document.querySelector<HTMLElement>("[data-promo-empty]")?.removeAttribute("hidden");
  }
</script>
