---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CallStrip from '../components/CallStrip.astro';
import Plans from '../components/Plans.astro';
import Compatibility from '../components/Compatibility.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import MimoPromoModal from '../components/MimoPromoModal.astro';
import site from '../data/site.json';
import plans from '../data/plans.json';
import faq from '../data/faq.json';

const origin = Astro.site ? Astro.site.href : 'https://megamovil.megacable.com.mx';
const allPlans = Object.values(plans.groups).flatMap((g) => g.plans);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    parentOrganization: { '@type': 'Organization', name: site.company },
    url: origin,
    slogan: site.tagline,
    sameAs: site.socials.filter((s) => !('inSchema' in s && s.inSchema === false)).map((s) => s.href),
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+52 33 9690 0000',
      contactType: 'customer support',
      areaServed: 'MX',
      availableLanguage: 'es',
    },
  }, 
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: origin,
    inLanguage: 'es-MX',
  },
  ...allPlans.map((p) => ({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${p.name} – ${p.highlight.value} ${p.highlight.unit}`,
    description: p.detail,
    brand: { '@type': 'Brand', name: site.name },
    offers: {
      '@type': 'Offer',
      price: p.price,
      priceCurrency: 'MXN',
      availability: 'https://schema.org/InStock',
      url: new URL('/planes', origin).href,
    },
  })),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.items.map((q) => ({
      '@type': 'Question',
      name: q.question,
      acceptedAnswer: { '@type': 'Answer', text: q.answer },
    })),
  },
];
---

<Layout {jsonLd}>
  <!-- ENCABEZADO UNIFICADO STICKY: Promo especial de urgencia + Menú siempre visibles al hacer scroll -->
  <div id="sticky-header-container" class="sticky top-0 z-50 w-full">
    <TopBar />
    <Header />
  </div>

  <main id="contenido">
    <!--
      Orden visual:
      · Celular (< 640 px): PLANES → banner. La franja "Cámbiate" no se muestra en celular (display none).
      · Tablet y escritorio: banner → franja → planes.
      El HTML conserva el orden banner → franja → planes (SEO y lectores de pantalla); solo cambia el orden visual con CSS.
    -->
    <div class="flex flex-col">
      <!-- 3. HERO PROMOCIONAL con Mimo 3D, Sticker de Precio HTML, GB Gigante y Rayas -->
      <div class="order-2 sm:order-1">
        <Hero />
      </div>
 
      <!-- 4. FRANJA "Cámbiate sin perder tu número": deja tu teléfono y te llaman (callcenter) o WhatsApp -->
      <div class="hidden sm:order-2 sm:block">
        <CallStrip />
      </div>

      <!-- 5. PLANES (Selector rápido + Franja Beneficios Pillofon + Familiares primero + Individuales) -->
      <div class="order-1 sm:order-3">        <Plans />
      </div>
    </div>

    <!-- De los planes para abajo: fondo blanco. La transición es un degradado sutil (sin corte, borde ni sombra) y hay más aire antes de compatibilidad. -->
    <div class="bg-[linear-gradient(to_bottom,#F8FAFC_0,#FFFFFF_280px)] pb-14 lg:pt-6">

    <!-- 7. COMPATIBILIDAD DE TU EQUIPO (Azul marino + Validador IMEI React + Pasos y Requisitos) -->
    <Compatibility />

    <!-- 9. FAQ (5 preguntas en acordeón compacto con FAQPage JSON-LD) -->
    <FaqSection />
    </div>
  </main>

  <!-- 11. FOOTER (Oscuro con borde de rayas, soporte y legales) -->
  <Footer flush />

  <!-- 12. FLOTANTES (WhatsApp avatar Mimo + barra sticky CTA móvil) -->
  <FloatingActions />
  <!-- 13. EXPERIENCIA INTERACTIVA MIMO: Cristal invisible + Super promo de bienvenida -->
  <MimoPromoModal />
</Layout>
