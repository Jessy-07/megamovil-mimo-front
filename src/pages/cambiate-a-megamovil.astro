---
/**
 * Cámbiate a Mega móvil (portabilidad). Misma URL que el sitio anterior.
 * Regla de esta página: UN solo camino y lo primero que se ve es CÓMO cambiarse (3 pasos).
 * Cada paso tiene su acción (SMS al 051, WhatsApp prellenado). Los planes van después, como opción.
 */
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import PageHero from "../components/PageHero.astro";
import Plans from "../components/Plans.astro";
import Icon from "../components/Icon.astro";
import { Check, MessageSquareText, Smartphone } from "lucide-react";
import data from "../data/cambiate.json";
import { planSummary, whatsappUrl } from "../utils/whatsapp";
import { brandHtml } from "../utils/brand";
// REFERENCIA: reemplazar por Mimo cargando una caja de mudanza (se "cambia" a Mega móvil). PNG transparente, ~500×500.
import mimoCambiate from "../assets/img/general/mimo-cambiate.png";

const origin = Astro.site ? Astro.site.href : "https://megamovil.megacable.com.mx";
const pageUrl = new URL("/cambiate-a-megamovil", origin).href;

const { hero, steps, compatibility, plans: plansCopy } = data;

type StepAction = { type: string; label: string; href?: string; text?: string };
const stepHref = (a: StepAction) => (a.text ? whatsappUrl(a.text) : (a.href ?? "#"));
const planWhatsapp = (plan: Parameters<typeof planSummary>[0]) => whatsappUrl(plansCopy.whatsappText.replace("{plan}", planSummary(plan)));

const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: data.seo.title, description: data.seo.description, url: pageUrl, inLanguage: "es-MX" },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: origin },
      { "@type": "ListItem", position: 2, name: "Cámbiate a Mega móvil", item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Cómo cambiarte a Mega móvil conservando tu número",
    step: steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s.title, text: s.text })),
  },
];

const whatsappPath =
  "M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z";
---

<Layout title={data.seo.title} description={data.seo.description} {jsonLd}>
  <!-- ENCABEZADO UNIFICADO STICKY -->
  <div id="sticky-header-container" class="sticky top-0 z-50 w-full">
    <TopBar />
    <Header />
  </div>

  <main id="contenido" class="bg-slate-50/60 pb-16">
    <!-- 1. HERO: el mensaje es "3 pasos". Sin botones: la acción está en los pasos, justo debajo. -->
    <PageHero
      id="cambiate-title"
      crumb="Cámbiate a Mega móvil"
      titleBefore={hero.titleBefore}
      titleHighlight={hero.titleHighlight}
      titleAfter={hero.titleAfter}
      subtitle={hero.subtitle}
      image={mimoCambiate}
      imageAlt="Mimo, la mascota de Mega móvil, te invita a cambiarte"
    >
      <Fragment slot="actions">
        <ul class="flex flex-wrap gap-2">
          {
            hero.highlights.map((h) => (
              <li class="inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/15 px-3.5 py-1.5 text-xs sm:text-sm font-bold text-white">
                <Check className="h-4 w-4 text-mega-orange" aria-hidden="true" />
                {h}
              </li>
            ))
          }
        </ul>
      </Fragment>
    </PageHero>

    <!-- 2. LOS 3 PASOS (tarjeta sobrepuesta al hero: es lo primero que se ve) -->
    <div class="container relative z-10 mx-auto -mt-12 px-4 sm:px-6 lg:px-8">
      <section aria-label="Pasos para cambiarte a Mega móvil" class="mx-auto max-w-5xl rounded-3xl bg-white p-6 sm:p-10 shadow-card-clean">
        <ol class="relative grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6">
          <!-- Línea que une los pasos (escritorio) -->
          <span class="absolute left-[16%] right-[16%] top-7 hidden h-0.5 bg-slate-200 md:block" aria-hidden="true"></span>
          {
            steps.map((s, i) => {
              const last = i === steps.length - 1;
              const a = s.action as StepAction;
              const href = stepHref(a);
              return (
                <li class="relative flex gap-4 md:flex-col md:items-center md:text-center">
                  <span
                    class:list={[
                      "relative z-10 grid h-14 w-14 shrink-0 place-items-center rounded-full font-display text-2xl font-black ring-4 ring-white",
                      last ? "bg-gradient-to-br from-mega-orange to-mega-orange-dark text-white shadow-orange-sm" : "bg-mega-navy text-white",
                    ]}
                  >
                    {last ? <Check className="h-7 w-7" aria-hidden="true" /> : i + 1}
                  </span>
                  <div class="min-w-0 flex-1 md:flex md:flex-col md:items-center">
                    <h2 class="font-display text-xl font-black text-mega-navy">{s.title}</h2>
                    <p class="mt-1 text-sm sm:text-base font-medium leading-relaxed text-slate-600">{s.text}</p>

                    {a.type === "sms" && (
                      <a href={href} class="mt-4 inline-flex items-center gap-2 rounded-full bg-mega-navy px-5 py-3 font-display text-sm font-black uppercase tracking-wider text-white hover:bg-mega-orange">
                        <MessageSquareText className="h-4 w-4" aria-hidden="true" />
                        {a.label}
                      </a>
                    )}
                    {a.type === "whatsapp" && (
                      <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-4 inline-flex items-center gap-2.5 rounded-full bg-[#25D366] px-5 py-3 font-display text-sm font-black uppercase tracking-wider text-white shadow-[0_10px_25px_-6px_rgba(37,211,102,0.55)] hover:bg-[#20ba5a]"
                      >
                        <svg viewBox="0 0 448 512" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d={whatsappPath} /></svg>
                        {a.label}
                      </a>
                    )}
                    {a.type === "link" && (
                      <a href={href} class="mt-4 inline-flex items-center gap-1.5 font-display text-sm font-black text-mega-orange hover:underline underline-offset-4">
                        <span set:html={brandHtml(a.label)} />
                        <Icon name="arrow-right" class="h-4 w-4" />
                      </a>
                    )}
                  </div>
                </li>
              );
            })
          }
        </ol>

        <p class="mt-8 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 border-t border-slate-100 pt-5 text-sm font-semibold text-slate-500">
          <Smartphone className="h-4 w-4 text-mega-orange" aria-hidden="true" />
          {compatibility.text}
          <a href={compatibility.href} class="font-black text-mega-orange hover:underline underline-offset-4">{compatibility.label}</a>
        </p>
      </section>
    </div>

    <!-- 3. PLANES (opcional): mismos del Home; el botón lleva al mismo WhatsApp con el plan ya escrito -->
    <Plans title={plansCopy.title} ctaLabel={plansCopy.ctaLabel} ctaHrefFor={planWhatsapp} />
  </main>

  <!-- FOOTER -->
  <Footer />

  <!-- BOTONES FLOTANTES -->
  <FloatingActions />
</Layout>
