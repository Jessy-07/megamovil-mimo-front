---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import PageHero from "../components/PageHero.astro";
import SalesBanner from "../components/SalesBanner.astro";
import Icon from "../components/Icon.astro";
import FaqAccordion from "../components/FaqAccordion";
import faqFull from "../data/faq-full.json";
import site from "../data/site.json";
import { faqPageSchema } from "../utils/faqSchema";
// REFERENCIA: reemplazar por Mimo en pose "pensando / con signo de interrogación" (PNG transparente, ~500×500).
import mimoPreguntas from "../assets/img/general/mimo-preguntas.png";

const origin = Astro.site ? Astro.site.href : "https://megamovil.megacable.com.mx";

const OWN_PAGE_CATEGORIES = ["esim", "roaming"];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: origin },
      { "@type": "ListItem", position: 2, name: "Preguntas frecuentes", item: new URL("/preguntas-frecuentes", origin).href },
    ],
  },
  // eSIM y roaming se declaran solo en su página (/esim, /roaming-internacional): Google pide no repetir la misma pregunta en dos páginas.
  faqPageSchema(faqFull.items.filter((q) => !OWN_PAGE_CATEGORIES.includes(q.category))),
];
---

<Layout
  title="Preguntas Frecuentes | Mega móvil"
  description="Resuelve tus dudas sobre planes, recargas, saldo, activación de SIM y eSIM, portabilidad y cobertura de Mega móvil."
  {jsonLd}
>
  <!-- ENCABEZADO UNIFICADO STICKY -->
  <div id="sticky-header-container" class="sticky top-0 z-50 w-full">
    <TopBar />
    <Header />
  </div>

  <main id="contenido" class="bg-slate-50/60 pb-16">
    <PageHero
      id="faq-title"
      crumb="Preguntas frecuentes"
      titleBefore="Preguntas "
      titleHighlight="frecuentes"
      subtitle="Busca tu duda o elige un tema. Respuestas claras, sin letras chiquitas."
      image={mimoPreguntas}
      imageAlt="Mimo, la mascota de Mega móvil, listo para resolver tus dudas"
    />

    <!-- BUSCADOR + PREGUNTAS (se sobrepone al hero, igual que Soporte) -->
    <div class="relative z-10 mx-auto -mt-12 max-w-[1440px] px-7 sm:px-12 lg:px-16">
      <div class="mx-auto max-w-5xl">
        <FaqAccordion client:load categories={faqFull.categories} items={faqFull.items} />

        <!-- ¿No encontraste tu respuesta? -->
        <section aria-labelledby="faq-ayuda-title" class="mt-10 flex flex-col md:flex-row md:items-center gap-5 rounded-3xl bg-white p-6 sm:p-8 shadow-card-clean">
          <div class="flex-1">
            <h2 id="faq-ayuda-title" class="font-display text-xl sm:text-2xl font-black uppercase tracking-tight text-mega-navy">¿No encontraste tu respuesta?</h2>
            <p class="mt-1 text-sm sm:text-base font-medium text-slate-500">
              Escríbenos por WhatsApp desde cualquier país o llámanos desde México.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a
              href={site.whatsapp.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 rounded-full bg-[#25D366] px-6 py-3 font-display text-sm font-black uppercase tracking-wider text-white shadow-[0_10px_25px_-6px_rgba(37,211,102,0.55)] hover:bg-[#20ba5a]"
            >
              <svg viewBox="0 0 448 512" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"></path>
              </svg>
              <span>WhatsApp</span>
            </a>
            <a
              href={site.support.href}
              class="inline-flex items-center justify-center gap-2 rounded-full bg-mega-navy px-6 py-3 font-display text-sm font-black uppercase tracking-wider text-white hover:bg-mega-orange"
            >
              <Icon name="phone" class="h-4 w-4" />
              <span>{site.support.phone}</span>
            </a>
          </div>
        </section>
      </div>
    </div>

    <!-- BANNER COMERCIAL -->
    <SalesBanner />
  </main>

  <!-- FOOTER -->
  <Footer />

  <!-- BOTONES FLOTANTES -->
  <FloatingActions />
</Layout>
