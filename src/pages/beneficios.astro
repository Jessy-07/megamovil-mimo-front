---
/**
 * Beneficios. Misma URL que el sitio anterior (/beneficios).
 * Textos oficiales tal cual (solo ortografía). En el sitio anterior cada texto estaba oculto tras "Ver más":
 * aquí se muestra todo de entrada y cada tarjeta trae su acción real (descargar la app, WhatsApp, marcar *1234…).
 * Ancla por beneficio (#wifi, #plan-control, #estrena-celular, #cobertura, #atencion).
 */
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import PageHero from "../components/PageHero.astro";
import Plans from "../components/Plans.astro";
import Icon from "../components/Icon.astro";
import { Globe2, Headset, Phone, ShieldCheck, Smartphone, Wifi } from "lucide-react";
import data from "../data/beneficios.json";
import { BRAND_LOGOS } from "../utils/brandLogos";
import { planSummary, whatsappUrl } from "../utils/whatsapp";
// REFERENCIA: reemplazar por Mimo festejando / con un regalo en las manos. PNG transparente, ~500×500.
import mimoBeneficios from "../assets/img/general/mimo-beneficios.png";

const origin = Astro.site ? Astro.site.href : "https://megamovil.megacable.com.mx";
const pageUrl = new URL("/beneficios", origin).href;

const { hero, benefits, footnote, plans: plansCopy } = data;
const icons = { wifi: Wifi, shield: ShieldCheck, smartphone: Smartphone, globe: Globe2, headset: Headset };
const storeLogos = { ios: BRAND_LOGOS.apple.path, android: BRAND_LOGOS.googleplay.path };
const storeHint = { ios: "Descárgala en", android: "Disponible en" };

type Action = { type: string; label: string; href?: string; text?: string; store?: string; mobileOnly?: boolean };
const planWhatsapp = (plan: Parameters<typeof planSummary>[0]) => whatsappUrl(plansCopy.whatsappText.replace("{plan}", planSummary(plan)));

const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: data.seo.title, description: data.seo.description, url: pageUrl, inLanguage: "es-MX" },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: origin },
      { "@type": "ListItem", position: 2, name: "Beneficios", item: pageUrl },
    ],
  },
];

const whatsappPath =
  "M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z";

// Ancho de cada tarjeta: 1 col en móvil, 2 en tableta, 3 en escritorio (la última fila de 2 queda centrada).
const cardWidth = "w-full sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.84rem)]";
---

<Layout title={data.seo.title} description={data.seo.description} {jsonLd}>
  <!-- ENCABEZADO UNIFICADO STICKY -->
  <div id="sticky-header-container" class="sticky top-0 z-50 w-full">
    <TopBar />
    <Header />
  </div>

  <main id="contenido" class="bg-slate-50/60 pb-16">
    <!-- 1. HERO -->
    <PageHero
      id="beneficios-title"
      crumb="Beneficios"
      titleBefore={hero.titleBefore}
      titleHighlight={hero.titleHighlight}
      image={mimoBeneficios}
      imageAlt="Mimo, la mascota de Mega móvil, te muestra los beneficios"
    />

    <!-- 2. BENEFICIOS (tarjeta sobrepuesta al hero). Todo el texto visible, sin "Ver más". -->
    <div class="relative z-10 mx-auto -mt-12 container px-7 sm:px-10 lg:px-12">
      <section aria-label="Beneficios Mega móvil" class="mx-auto max-w-6xl rounded-3xl bg-white p-5 sm:p-8 lg:p-10 shadow-card-clean">
        <ul class="flex flex-wrap justify-center gap-5">
          {
            benefits.map((b) => {
              const BenefitIcon = icons[b.icon as keyof typeof icons];
              return (
                <li id={b.id} class:list={["scroll-mt-36", cardWidth]}>
                  <!-- Tarjeta como las del Home: fondo blanco, borde fino, sin sombra -->
                  <article class="flex h-full flex-col rounded-3xl border border-slate-200 bg-white p-5 sm:p-6">
                    <div class="flex items-center gap-4">
                      <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-orange-50 text-mega-orange">
                        <BenefitIcon className="h-7 w-7" aria-hidden="true" />
                      </span>
                      <h2 class="font-display text-xl font-black leading-tight text-mega-navy">{b.title}</h2>
                    </div>

                    <p class="mt-4 font-display text-base font-black text-mega-orange text-balance">{b.headline}</p>
                    <p class="mt-1 text-sm sm:text-base font-medium leading-relaxed text-slate-600">{b.text}</p>

                    <div class="mt-auto flex flex-wrap gap-2.5 pt-5">
                      {(b.actions as Action[]).map((a) => {
                        if (a.type === "store") {
                          const store = a.store as keyof typeof storeLogos;
                          return (
                            <a
                              href={a.href}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex items-center gap-2 rounded-xl bg-mega-navy px-3.5 py-2 text-white hover:bg-black"
                            >
                              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d={storeLogos[store]} /></svg>
                              <span class="text-left leading-tight">
                                <span class="block text-[9px] font-bold uppercase tracking-wider opacity-80">{storeHint[store]}</span>
                                <span class="block font-display text-xs font-black uppercase">{a.label}</span>
                              </span>
                            </a>
                          );
                        }
                        if (a.type === "whatsapp") {
                          return (
                            <a
                              href={whatsappUrl(a.text ?? "")}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex h-11 items-center gap-2 whitespace-nowrap rounded-full bg-[#25D366] px-5 font-display text-sm sm:text-base font-extrabold text-white hover:bg-[#20ba5a]"
                            >
                              <svg viewBox="0 0 448 512" fill="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true"><path d={whatsappPath} /></svg>
                              {a.label}
                            </a>
                          );
                        }
                        if (a.type === "tel") {
                          return (
                            <a
                              href={a.href}
                              class:list={[
                                "h-11 items-center gap-2 whitespace-nowrap rounded-full bg-mega-navy px-5 font-display text-sm sm:text-base font-extrabold text-white hover:bg-mega-navy/90",
                                a.mobileOnly ? "hidden [@media(pointer:coarse)]:inline-flex" : "inline-flex",
                              ]}
                            >
                              <Phone className="h-5 w-5 shrink-0" aria-hidden="true" />
                              {a.label}
                            </a>
                          );
                        }
                        const external = a.type === "external";
                        return (
                          <a
                            href={a.href}
                            target={external ? "_blank" : undefined}
                            rel={external ? "noopener noreferrer" : undefined}
                            class="inline-flex items-center gap-1.5 font-display text-base font-extrabold text-mega-orange hover:underline underline-offset-4"
                          >
                            {a.label}
                            <Icon name={external ? "external-link" : "arrow-right"} class="h-4 w-4" />
                          </a>
                        );
                      })}
                    </div>
                  </article>
                </li>
              );
            })
          }
        </ul>

        <p class="mt-6 text-center text-xs font-semibold text-slate-500">{footnote}</p>
      </section>
    </div>

    <!-- 3. PLANES: mismos del Home; el botón abre WhatsApp con el plan ya escrito -->
    <Plans title={plansCopy.title} ctaHrefFor={planWhatsapp} />
  </main>

  <!-- FOOTER -->
  <Footer />

  <!-- BOTONES FLOTANTES -->
  <FloatingActions />
</Layout>
