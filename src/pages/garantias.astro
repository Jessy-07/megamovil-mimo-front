---
/**
 * Garantías de equipos. Misma URL que el sitio anterior (megamovil.mx/garantias); la enlaza el footer
 * ("Garantías → Samsung | Motorola | Huawei | Hisense | ZTE"). Texto legal en data/garantias.json, TAL CUAL.
 * CTA: la garantía se hace en el CIS, así que la acción principal es ubicarlo; WhatsApp para dudas.
 */
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import PageHero from "../components/PageHero.astro";
import LegalDocument from "../components/LegalDocument.astro";
import type { LegalSection } from "../components/LegalDocument.astro";
import data from "../data/garantias.json";

const origin = Astro.site ? Astro.site.href : "https://megamovil.megacable.com.mx";
const pageUrl = new URL("/garantias", origin).href;
const { hero, help, sections } = data;

const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: data.seo.title, description: data.seo.description, url: pageUrl, inLanguage: "es-MX" },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: origin },
      { "@type": "ListItem", position: 2, name: "Garantías", item: pageUrl },
    ],
  },
];
---

<Layout title={data.seo.title} description={data.seo.description} {jsonLd}>
  <!-- ENCABEZADO UNIFICADO STICKY -->
  <div id="sticky-header-container" class="sticky top-0 z-50 w-full">
    <TopBar />
    <Header />
  </div>

  <main id="contenido" class="bg-slate-50/60 pb-16">
    <PageHero id="garantias-title" crumb="Garantías" titleBefore={hero.titleBefore} titleHighlight={hero.titleHighlight} titleAfter={hero.titleAfter} />
    <LegalDocument labelledBy="garantias-title" sections={sections as LegalSection[]} {help} />
  </main>

  <!-- FOOTER -->
  <Footer />

  <!-- BOTONES FLOTANTES -->
  <FloatingActions />
</Layout>
