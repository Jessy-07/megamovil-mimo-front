---
/**
 * Planes internacionales (roaming). Misma URL que el sitio anterior: /roaming-internacional.
 * Son paquetes ADICIONALES al plan base. EE.UU. y Canadá ya están en el plan (se avisa en el banner).
 */
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import PageHero from "../components/PageHero.astro";
import SalesBanner from "../components/SalesBanner.astro";
import RoamingPlans from "../components/RoamingPlans";
import FaqAccordion from "../components/FaqAccordion";
import { Check } from "lucide-react";
import data from "../data/roaming.json";
import faqFull from "../data/faq-full.json";
import site from "../data/site.json";
import { whatsappUrl } from "../utils/whatsapp";
import { faqPageSchema } from "../utils/faqSchema";
// REFERENCIA: reemplazar por Mimo con maleta de viaje / pasaporte. PNG transparente, ~500×500.
import mimoViaje from "../assets/img/general/mimo-viaje.png";

const origin = Astro.site ? Astro.site.href : "https://megamovil.megacable.com.mx";
const pageUrl = new URL("/roaming-internacional", origin).href;

const zoneName = (id: string) => data.zones.find((z) => z.id === id)?.name ?? id;

// Cada paquete abre WhatsApp con el paquete ya escrito (en el sitio anterior el botón no hacía nada).
const plans = data.plans.map((p) => ({
  ...p,
  href: whatsappUrl(
    data.planWhatsapp
      .replace("{zona}", zoneName(p.zone))
      .replace("{datos}", p.data)
      .replace("{dias}", String(p.days))
      .replace("{precio}", p.price.toLocaleString("es-MX")),
  ),
}));

const roamingFaq = faqFull.items.filter((q) => q.category === "roaming");
const roamingCategory = faqFull.categories.filter((c) => c.id === "roaming");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: origin },
      { "@type": "ListItem", position: 2, name: "Planes internacionales", item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Paquetes de roaming internacional Mega móvil",
    itemListElement: data.plans.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Product",
        name: `Roaming ${zoneName(p.zone)} ${p.data} por ${p.days} días`,
        brand: { "@type": "Brand", name: site.name },
        offers: { "@type": "Offer", price: p.price, priceCurrency: "MXN", availability: "https://schema.org/InStock", url: pageUrl },
      },
    })),
  },
  faqPageSchema(roamingFaq),
];
---

<Layout title={data.seo.title} description={data.seo.description} {jsonLd}>
  <!-- ENCABEZADO UNIFICADO STICKY -->
  <div id="sticky-header-container" class="sticky top-0 z-50 w-full">
    <TopBar />
    <Header />
  </div>

  <main id="contenido" class="bg-slate-50/60 pb-16">
    <!-- 1. HERO -->
    <PageHero
      id="roaming-title"
      crumb="Planes internacionales"
      titleBefore={data.hero.titleBefore}
      titleHighlight={data.hero.titleHighlight}
      subtitle={data.hero.subtitle}
      image={mimoViaje}
      imageAlt="Mimo, la mascota de Mega móvil, listo para viajar"
    >
      <Fragment slot="actions">
        <ul class="flex flex-wrap gap-2">
          {
            data.hero.highlights.map((h) => (
              <li class="inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/15 px-3.5 py-1.5 text-xs sm:text-sm font-bold text-white">
                <Check className="h-4 w-4 text-mega-orange" aria-hidden="true" />
                {h}
              </li>
            ))
          }
        </ul>
      </Fragment>
    </PageHero>

    <!-- 2. ¿A DÓNDE VIAJAS? + PAQUETES (tarjeta sobrepuesta al hero) -->
    <div class="container relative z-10 mx-auto -mt-12 px-4 sm:px-6 lg:px-8">
      <section aria-label="Paquetes de roaming internacional" class="mx-auto max-w-5xl rounded-3xl bg-white p-6 sm:p-10 shadow-card-clean">
        <RoamingPlans zones={data.zones} plans={plans} ctaLabel={data.planCta} />
      </section>

      <!-- 3. PREGUNTAS FRECUENTES DE ROAMING (fuente única: faq-full.json, categoría "roaming") -->
      <section id="preguntas" aria-labelledby="roaming-faq-title" class="scroll-mt-36 mx-auto mt-10 max-w-5xl">
        <h2 id="roaming-faq-title" class="mb-5 text-center font-display text-2xl sm:text-3xl font-black uppercase tracking-tight text-mega-navy">
          Preguntas frecuentes
        </h2>
        <FaqAccordion client:visible variant="simple" hideCtas categories={roamingCategory} items={roamingFaq} />
      </section>
    </div>

    <!-- 4. VENTA DEL PLAN BASE (para quien aún no es cliente) -->
    <SalesBanner
      title="¿Aún no eres Mega móvil?"
      text="Todos los planes ya incluyen llamadas y SMS a EE.UU. y Canadá. Y para el resto del mundo, agrega un paquete."
    />
  </main>

  <!-- FOOTER -->
  <Footer />

  <!-- BOTONES FLOTANTES -->
  <FloatingActions />
</Layout>
