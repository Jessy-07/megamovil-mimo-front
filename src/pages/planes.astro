---
/**
 * Planes — catálogo para quien ya está comparando (misma URL que el sitio anterior: /planes).
 * Mismos planes que el Home (plans.json) y nada más que dos ayudas pequeñas: sin saturar.
 * El botón de cada plan abre WhatsApp con el plan ya escrito (mientras no exista /contratar).
 */
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import PageHero from "../components/PageHero.astro";
import Plans from "../components/Plans.astro";
import Icon from "../components/Icon.astro";
import { Repeat } from "lucide-react";
import page from "../data/planes-page.json";
import plans from "../data/plans.json";
import site from "../data/site.json";
import { planSummary, whatsappUrl } from "../utils/whatsapp";
// REFERENCIA: reemplazar por Mimo sosteniendo un cartel de precio o señalando los planes. PNG transparente, ~500×500.
import mimoPlanes from "../assets/img/general/mimo-planes.png";

const origin = Astro.site ? Astro.site.href : "https://megamovil.megacable.com.mx";
const pageUrl = new URL("/planes", origin).href;

const planWhatsapp = (plan: Parameters<typeof planSummary>[0]) => whatsappUrl(page.plans.whatsappText.replace("{plan}", planSummary(plan)));

const allPlans = Object.values(plans.groups).flatMap((g) => g.plans);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: origin },
      { "@type": "ListItem", position: 2, name: "Planes", item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Planes Mega móvil",
    itemListElement: allPlans.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Product",
        name: planSummary(p).replace(/ de \$\d+\/mes$/, ""),
        description: p.detail,
        brand: { "@type": "Brand", name: site.name },
        offers: { "@type": "Offer", price: p.price, priceCurrency: "MXN", availability: "https://schema.org/InStock", url: `${pageUrl}#plan-${p.slug}` },
      },
    })),
  },
];

const whatsappPath =
  "M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z";
---

<Layout title={page.seo.title} description={page.seo.description} {jsonLd}>
  <!-- ENCABEZADO UNIFICADO STICKY -->
  <div id="sticky-header-container" class="sticky top-0 z-50 w-full">
    <TopBar />
    <Header />
  </div>

  <main id="contenido" class="bg-slate-50/60 pb-16">
    <!-- 1. HERO -->
    <PageHero
      id="planes-title"
      crumb="Planes"
      titleBefore={page.hero.titleBefore}
      titleHighlight={page.hero.titleHighlight}
      subtitle={page.hero.subtitle}
      image={mimoPlanes}
      imageAlt="Mimo, la mascota de Mega móvil, te presenta los planes"
    />

    <!-- 2. PLANES (tarjeta sobrepuesta al hero). Mismos datos y componente que el Home. -->
    <div class="relative z-10 mx-auto -mt-12 max-w-[1440px] px-7 sm:px-12 lg:px-16">
      <div class="rounded-3xl bg-white shadow-card-clean [&>section]:px-2 sm:[&>section]:px-4 [&>section]:!pt-8 [&>section]:!pb-10">
        <Plans ctaHrefFor={planWhatsapp} />
      </div>
    </div>

    <!-- 3. DOS AYUDAS PEQUEÑAS: para el indeciso y para quien viene de otra compañía -->
    <div class="mx-auto mt-8 max-w-[1440px] px-7 sm:px-12 lg:px-16">
      <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          page.help.map((h) => {
            const isWa = h.icon === "whatsapp";
            const href = isWa && h.whatsappText ? whatsappUrl(h.whatsappText) : (h.href ?? "#");
            return (
              <li>
                <a
                  href={href}
                  {...(isWa ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  class="group flex h-full items-center gap-4 rounded-3xl border-2 border-transparent bg-white p-5 sm:p-6 shadow-card-clean hover:border-mega-orange"
                >
                  <span class:list={["grid h-12 w-12 shrink-0 place-items-center rounded-2xl", isWa ? "bg-[#25D366] text-white" : "bg-orange-50 text-mega-orange"]}>
                    {isWa ? (
                      <svg viewBox="0 0 448 512" fill="currentColor" class="h-6 w-6" aria-hidden="true"><path d={whatsappPath} /></svg>
                    ) : (
                      <Repeat className="h-6 w-6" aria-hidden="true" />
                    )}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-display text-lg font-black text-mega-navy">{h.title}</span>
                    <span class="block text-sm font-medium text-slate-500">{h.text}</span>
                  </span>
                  <span class="hidden sm:inline-flex shrink-0 items-center gap-1.5 font-display text-sm font-black uppercase tracking-wider text-mega-orange">
                    {h.label}
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </main>

  <!-- FOOTER -->
  <Footer />

  <!-- BOTONES FLOTANTES -->
  <FloatingActions />
</Layout>
